import urllib.request,re,html
u='https://docs.vllm.ai/en/latest/design/prefix_caching/'
req=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})
raw=urllib.request.urlopen(req,timeout=10).read().decode('utf-8','ignore')
raw=re.sub(r'<script.*?</script>',' ',raw,flags=re.S)
raw=re.sub(r'<style.*?</style>',' ',raw,flags=re.S)
text=html.unescape(re.sub('<["'^>]+>'"',' ',raw))
text=' '.join(text.split())
for term in ['Automatic Prefix Caching', 'full blocks', 'Block Allocation', 'Eviction (LRU)', 'The cache eviction policy', 'Once a block']:
 i=text.lower().find(term.lower())
 print('\\nTERM',term,'idx',i)
 if i>=0: print(text[max(0,i-600):i+1800])
