mamou"><span class="fullname font-sans font-semibold max-sm:text-sm">Jonathan Mamou</span> <div class="my-0.5 flex items-center gap-x-2"><span class="inline-block "><span class="contents"><span class="leading-tight! block font-mono text-xs underline">jmamou</span><!----><!----></span> <!--[-1--><!--]--></span><!---->  <div><!--[0--><div class="relative flex items-center gap-1.5  "><!--[0--><button class="flex items-center justify-center rounded-full border-[1.5px] transition-colors duration-200   w-18 h-[20px] text-xs  border-transparent bg-black text-white dark:bg-white dark:text-black" type="button"><div class="flex h-full flex-1 items-center justify-center rounded-full"><!--[-1-->Follow<!--]--></div></button><!--]--> <!--[-1--><!--]--></div><!--]--><!----></div></div></a> <div class="flex items-center pt-0.5"><!--[0--><a href="/Intel" class="mr-1.5 flex-none" title="Intel"><img class="rounded-sm! size-4 select-none" alt="Intel's avatar" src="https://cdn-avatars.huggingface.co/v1/production/uploads/1616186257611-60104afcc75e19ac1738fe70.png" loading="lazy"/></a> <a href="/Intel" class="rounded-sm bg-gray-100 px-1 font-mono text-xs leading-normal text-gray-600 dark:bg-gray-700">Intel</a><!--]--></div></div></div><div class="flex items-center font-sans leading-tight"><span class="inline-block "><span class="contents"><a href="/orenpereg"><img class="rounded-full! m-0 mr-2.5 size-9 sm:mr-3 sm:size-12" alt="Oren Pereg's avatar" src="https://cdn-avatars.huggingface.co/v1/production/uploads/1664643955283-60570320cbe9c7542f3501e3.jpeg"/></a><!----><!----></span> <!--[-1--><!--]--></span><!----> <div class="text-gray-900 dark:text-gray-300"><a href="/orenpereg"><span class="fullname font-sans font-semibold max-sm:text-sm">Oren Pereg</span> <div class="my-0.5 flex items-center gap-x-2"><span class="inline-block "><span class="contents"><span class="leading-tight! block font-mono text-xs underline">orenpereg</span><!----><!----></span> <!--[-1--><!--]--></span><!---->  <div><!--[0--><div class="relative flex items-center gap-1.5  "><!--[0--><button class="flex items-center justify-center rounded-full border-[1.5px] transition-colors duration-200   w-18 h-[20px] text-xs  border-transparent bg-black text-white dark:bg-white dark:text-black" type="button"><div class="flex h-full flex-1 items-center justify-center rounded-full"><!--[-1-->Follow<!--]--></div></button><!--]--> <!--[-1--><!--]--></div><!--]--><!----></div></div></a> <div class="flex items-center pt-0.5"><!--[0--><a href="/Intel" class="mr-1.5 flex-none" title="Intel"><img class="rounded-sm! size-4 select-none" alt="Intel's avatar" src="https://cdn-avatars.huggingface.co/v1/production/uploads/1616186257611-60104afcc75e19ac1738fe70.png" loading="lazy"/></a> <a href="/Intel" class="rounded-sm bg-gray-100 px-1 font-mono text-xs leading-normal text-gray-600 dark:bg-gray-700">Intel</a><!--]--></div></div></div><div class="flex items-center font-sans leading-tight"><span class="inline-block "><span class="contents"><a href="/joaogante"><img class="rounded-full! m-0 mr-2.5 size-9 sm:mr-3 sm:size-12" alt="Joao Gante's avatar" src="https://cdn-avatars.huggingface.co/v1/production/uploads/1641203017724-noauth.png"/></a><!----><!----></span> <!--[-1--><!--]--></span><!----> <div class="text-gray-900 dark:text-gray-300"><a href="/joaogante"><span class="fullname font-sans font-semibold max-sm:text-sm">Joao Gante</span> <div class="my-0.5 flex items-center gap-x-2"><span class="inline-block "><span class="contents"><span class="leading-tight! block font-mono text-xs underline">joaogante</span><!----><!----></span> <!--[-1--><!--]--></span><!---->  <div><!--[0--><div class="relative flex items-center gap-1.5  "><!--[0--><button class="flex items-center justify-center rounded-full border-[1.5px] transition-colors duration-200   w-18 h-[20px] text-xs  border-transparent bg-black text-white dark:bg-white dark:text-black" type="button"><div class="flex h-full flex-1 items-center justify-center