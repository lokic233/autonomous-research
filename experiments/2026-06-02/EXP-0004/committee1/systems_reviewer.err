/bin/zsh -lc "python3 - <<'PY'
import urllib.request,re
text=re.sub('<["'^<]+?>'"',' ',urllib.request.urlopen('https://arxiv.org/html/2603.18897v1',timeout=15).read(1500000).decode('utf-8','ignore'))
text=re.sub(r'\\s+',' ',text)
for pat in ['reduces', '%', 'accuracy', 'overhead', 'p50', 'p95', 'speedup', 'AgentBench', 'SWE']:
    idx=text.lower().find(pat.lower())
    print('\\nPAT',pat,'IDX',idx)
    if idx>=0: print(text[max(0,idx-700):idx+1800])
# find all percentage-ish snippets around 'latency'
for m in re.finditer(r'\\b\\d+(?:\\.\\d+)?\\s*%', text):
    s=max(0,m.start()-220); e=min(len(text),m.end()+220)
    sn=text[s:e]
    if any(w in sn.lower() for w in ['latency','accuracy','overhead','reduction','paste','speed']):
        print('\\nPCT',sn)
