  {system: "vLLM", url: "https://docs.vllm.ai/en/stable/features/tool_calling/", overlap: "Tool calling support, but no evidence found of firing tools before argument JSON is complete."},
  {system: "TensorRT-LLM", url: "https://nvidia.github.io/TensorRT-LLM/advanced/speculative-decoding.html", overlap: "Speculative decoding for tokens, not speculative external tool execution."},
  {system: "FlashInfer", url: "https://github.com/flashinfer-ai/flashinfer", overlap: "Inference kernels and speculative sampling primitives, not agent tool-call prefetch."},
  {system: "LMCache", url: "https://github.com/LMCache/LMCache", overlap: "KV-cache reuse/prefix caching for LLM serving, not tool-call speculation."},
