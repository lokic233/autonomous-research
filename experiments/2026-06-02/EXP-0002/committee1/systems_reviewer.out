  {system: "SGLang priority eviction", url: "https://github.com/sgl-project/sglang/blob/main/python/sglang/srt/mem_cache/evict_policy.py", overlap: "Shipping priority-aware eviction exists: lower priority evicted first, LRU within same priority; appears request/node priority rather than documented token-range committed/transient tagging."},
  {system: "vLLM automatic prefix caching", url: "https://docs.vllm.ai/en/stable/design/prefix_caching/", overlap: "Prefix cache manager with LRU eviction and tail-block eviction bias; useful baseline, not the semantic priority policy."},
