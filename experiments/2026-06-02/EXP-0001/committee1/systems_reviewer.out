ROLE: systems_reviewer  VOTE: red
EXISTING_IMPLEMENTATIONS: [
  {system: "TensorRT-LLM", url: "https://nvidia.github.io/TensorRT-LLM/features/kvcache.html", overlap: "Direct: prioritized LRU KV block eviction; request retention policy assigns priorities to token ranges, including example system-prompt tokens at priority 100 vs default 35; lower-priority blocks evicted first."},
  {system: "SGLang", url: "https://github.com/sgl-project/sglang/blob/main/python/sglang/srt/mem_cache/evict_policy.py", overlap: "Partial: Radix cache supports PriorityStrategy: lower priority evicted first, then LRU within same priority; generic priority mechanism, not tool-boundary specific."},
  {system: "vLLM", url: "https://docs.vllm.ai/en/latest/design/prefix_caching/", overlap: "Baseline: automatic prefix caching with block-hash prefix semantics and LRU eviction/free queue; no semantic tool-boundary retention found."},
  {system: "LMCache", url: "https://github.com/LMCache/LMCache", overlap: "Adjacent: KV reuse/offload across vLLM instances; not evidence of tool-schema-aware retention policy."}
