  {system: "NeMo Guardrails code", url: "https://github.com/NVIDIA/NeMo-Guardrails/blob/develop/nemoguardrails/rails/llm/buffer.py", overlap: "Direct mechanism: RollingBuffer accumulates stream chunks, yields processing_context = current chunk plus prior context, and retains context_size tokens for next chunk."},
