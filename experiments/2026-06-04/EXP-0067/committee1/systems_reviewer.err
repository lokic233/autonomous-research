Active/selected nav item: use primary-tinted background instead of grey */\n/* Handles common states: aria-current, .active, and Tailwind text-primary classnames */\n.sidebar a[aria-current=\"page\"] code,\n.sidebar-content a[aria-current=\"page\"] code,\nli[data-title] a[aria-current=\"page\"] code,\n.sidebar a.active code,\n.sidebar-content a.active code,\nli[data-title] a.active code,\n.sidebar a[class*=\"text-primary\"] code,\n.sidebar-content a[class*=\"text-primary\"] code,\nli[data-title] a[class*=\"text-primary\"] code {\n  color: currentColor;\n  background: color-mix(in srgb, currentColor 15%, transparent);\n}\n"])</script><script>self.__next_f.push([1,"48:T73e,"])</script><script>self.__next_f.push([1,"// Cal.com inline embed initializer for Mintlify\n(() =\u003e {\n  const WIDGET_SELECTOR = '#my-cal-inline-demo';\n  const SCRIPT_SRC = 'https://app.cal.com/embed/embed.js';\n\n  let scriptRequested = false;\n\n  function whenCalReady(callback) {\n    if (window.Cal \u0026\u0026 window.Cal.loaded) {\n      callback();\n      return;\n    }\n    if (!scriptRequested) {\n      const s = document.createElement('script');\n      s.src = SCRIPT_SRC;\n      s.async = true;\n      s.onload = () =\u003e callback();\n      document.head.appendChild(s);\n      scriptRequested = true;\n    } else {\n      const interval = setInterval(() =\u003e {\n        if (window.Cal \u0026\u0026 window.Cal.loaded) {\n          clearInterval(interval);\n          callback();\n        }\n      }, 50);\n    }\n  }\n\n  function initCalWidget() {\n    const container = document.querySelector(WIDGET_SELECTOR);\n    if (!container) return;\n\n    whenCalReady(() =\u003e {\n      try {\n        // Namespace 'demo' as in Cal's snippet\n        window.Cal('init', 'demo', { origin: 'https://app.cal.com' });\n\n        window.Cal.ns.demo('inline', {\n          elementOrSelector: WIDGET_SELECTOR,\n          config: { layout: 'month_view' },\n          calLink: 'team/snowglobe/demo',\n        });\n\n        window.Cal.ns.demo('ui', {\n          cssVarsPerTheme: {\n            light: { 'cal-brand': '#CC1757' },\n            dark: { 'cal-brand': '#FFC8E5' },\n          },\n          hideEventTypeDetails: false,\n          layout: 'month_view',\n        });\n      } catch (err) {\n        console.error('Cal embed initialization failed:', err);\n      }\n    });\n  }\n\n  function run() {\n    initCalWidget();\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', run);\n  } else {\n    run();\n  }\n\n  const observer = new MutationObserver(run);\n  observer.observe(document.body, { childList: true, subtree: true });\n})();\n"])</script><script>self.__next_f.push([1,"49:Td22,"])</script><script>self.__next_f.push([1,"// Wrap backticked segments in \u003ccode\u003e inside the sidebar nav and page title\n(() =\u003e {\n  // Expose a flag for quick manual verification in console\n  window.__sidebar_codeify_loaded = true;\n\n  // Likely containers/selectors based on Mintlify docs\n  const CONTAINER_SELECTORS = [\n    // Sidebar containers\n    '.sidebar',\n    '.sidebar-content',\n    '[class*=\"sidebar\"]',\n    '[data-identifier=\"sidebar\"]',\n    '[data-identifier=\"sidebar-content\"]',\n    // Nav item \u003cli\u003e that carries the title\n    'li[data-title]',\n    // Sidebar text targets\n    '.sidebar-title',\n    '.sidebar-group',\n    '.sidebar-group-header',\n    '.sidebar a',\n    '.sidebar-content a',\n    '[data-identifier=\"sidebar\"] a',\n    '[data-identifier=\"sidebar-content\"] a',\n    // Dropdown titles (if used in nav)\n    '.nav-dropdown-item-title',\n    '.navigation-items',\n    // Page title\n    '.page-title',\n    '#page-title',\n    '[data-identifier=\"sidebar-title\"]',\n    '[data-identifier=\"page-title\"]'\n  ].join(',');\n\n  const BACKTICK_PATTERN = /(`[^`]+`)/g;\n\n  function splitIntoParts(text) {\n    return text.split(BACKTICK_PATTERN);\n  }\n\n  function renderParts(parts) {\n    const fragment = document.createDocumentFragment();\n    for (const part of parts) {\n      if (!part) continue;\n      if (part.startsWith('`') \u0026\u0026 part.endsWith('`')) {\n        const code = document.createElement('code');\n        code.textContent = part.slice(1, -1);\n        fragment.appendChild(code);\n      } else {\n        fragment.appendChild(document.createTextNode(part));\n      }\n    }\n    return fragment;\n  }\n\n  function codeifyTextNode(textNode) {\n    const value = textNode.nodeValue || '';\n    if (!value.includes('`')) return;\n    const parts = splitIntoParts(value);\n    const fragment = renderParts(parts);\n    textNode.replaceWith(fragment);\n  }\n\n  function processElement(el) {\n    if (!el || el.dataset?.codeified === 'true') return;\n    // Skip if already contains \u003ccode\u003e\n    if (el.querySelector \u0026\u0026 el.querySelector('code')) {\n      el.dataset.codeified = 'true';\n      return;\n    }\n    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null);\n    const textNodes = [];\n    while (walker.nextNode()) {\n      textNodes.push(walker.currentNode);\n    }\n    let changed = false;\n    for (const tn of textNodes) {\n      if ((tn.nodeValue || '').includes('`')) {\n        codeifyTextNode(tn);\n        changed = true;\n      }\n    }\n    if (changed) {\n      el.dataset.codeified = 'true';\n    }\n  }\n\n  function run(root = document) {\n    const nodes = root.querySelectorAll(CONTAINER_SELECTORS);\n    nodes.forEach(processElement);\n  }\n\n  const observer = new MutationObserver((mutations) =\u003e {\n    for (const m of mutations) {\n      if (m.type === 'childList') {\n        if (m.addedNodes \u0026\u0026 m.addedNodes.length) {\n          m.addedNodes.forEach((n) =\u003e {\n            if (n.nodeType === Node.ELEMENT_NODE) run(n);\n          });\n        }\n      } else if (m.type === 'characterData') {\n        const parent = m.target.parentElement;\n        if (parent) processElement(parent);\n      }\n    }\n  });\n\n  function start() {\n    run(document);\n    observer.observe(document.body, {\n      childList: true,\n      subtree: true,\n      characterData: true\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', start);\n  } else {\n    start();\n  }\n})();\n"])</script><script>self.__next_f.push([1,"32:[\"$\",\"$L3f\",null,{\"value\":{\"apiReferenceData\":{}},\"children\":[\"$\",\"$L40\",null,{\"value\":{\"pageMetadata\":\"$1c:props:pageMetadata\",\"lastModified\":\"2026-05-29T19:30:51.279Z\",\"originalFileLocation\":\"guardrails/docs/concepts/streaming/streaming.mdx\",\"description\":null,\"mdxExtracts\":{\"tableOfContents\":[{\"title\":\"Async Streaming\",\"slug\":\"async-streaming\",\"depth\":2,\"children\":[]}],\"codeExamples\":{}},\"pageType\":\"$undefined\",\"panelMdxSource\":\"$undefined\",\"panelMdxSourceWithNoJs\":\"$undefined\",\"contextualStarterQuestions\":\"$undefined\",\"relatedPages\":\"$undefined\"},\"children\":[\"$\",\"$L41\",null,{\"pageMetadata\":\"$1c:props:pageMetadata\",\"docsConfig\":\"$1c:props:docsConfig\",\"mdxExtracts\":\"$32:props:children:props:value:mdxExtracts\",\"openApiReferenceData\":\"$undefined\",\"children\":[\"$\",\"$L42\",null,{\"children\":[[[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"document.documentElement.setAttribute('data-page-mode', \\\"none\\\");\"}}],[\"$\",\"$L43\",null,{\"mode\":\"none\"}]],[\"$\",\"$L44\",null,{\"theme\":\"aspen\"}],[\"$\",\"$L45\",null,{\"docsConfig\":\"$1c:props:docsConfig\",\"pageMetadata\":\"$1c:props:pageMetadata\"}],[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"snowglobe/style.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$46\"}}]],[\"$\",\"$L47\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"689bc25e6ae2177f4d4f06ec\",\"filePath\":\"cal-embed.js\",\"subdomain\":\"snowglobe\",\"__v\":0,\"content\":\"$48\"},{\"_id\":\"689bc25f6ae2