\":[\"guardrails/docs/concepts/guard\",\"guardrails/docs/concepts/validators\",\"guardrails/docs/concepts/validator_on_fail_actions\",\"guardrails/docs/concepts/hub\",\"guardrails/docs/concepts/performance\",\"guardrails/docs/concepts/deploying\",\"guardrails/docs/concepts/remote_validation_inference\",{\"group\":\"Streaming\",\"pages\":[\"guardrails/docs/concepts/streaming/streaming\",\"guardrails/docs/concepts/streaming/async_streaming\",\"guardrails/docs/concepts/streaming/streaming_structured_data\",\"guardrails/docs/concepts/streaming/streaming_fixes\"]},\"guardrails/docs/concepts/concurrency\",\"guardrails/docs/concepts/logs\",\"guardrails/docs/concepts/telemetry\",\"guardrails/docs/concepts/error_remediation\"]},{\"tab\":\"Tutorials\",\"groups\":[{\"group\":\"How-to guides\",\"icon\":\"map\",\"pages\":[\"guardrails/docs/how-to-guides/using_llms\",\"guardrails/docs/how-to-guides/enable_streaming\",\"guardrails/docs/how-to-guides/generate_structured_data\",\"guardrails/docs/how-to-guides/custom_validators\",\"guardrails/docs/how-to-guides/use_on_fail_actions\",\"guardrails/docs/how-to-guides/hosting_validator_models\",\"guardrails/docs/how-to-guides/hosting_with_docker\",\"guardrails/docs/how-to-guides/continuous_integration_continuous_deployment\"]},{\"group\":\"Sample apps\",\"icon\":\"flask\",\"pages\":[\"guardrails/docs/sample_apps/chatbot\",\"guardrails/docs/sample_apps/summarizer\"]}]},{\"tab\":\"Integrations\",\"pages\":[\"guardrails/docs/integrations/langchain\",\"guardrails/docs/integrations/llamaindex\",\"guardrails/docs/integrations/mlflow-genai\",{\"group\":\"Telemetry\",\"pages\":[\"guardrails/docs/integrations/telemetry/arize-ai\",\"guardrails/docs/integrations/telemetry/grafana\",\"guardrails/docs/integrations/telemetry/openlit\",\"guardrails/docs/integrations/telemetry/mlflow-tracing\"]}]},{\"tab\":\"API Reference\",\"pages\":[{\"group\":\"Python\",\"pages\":[\"guardrails/docs/api_reference_markdown/actions\",\"guardrails/docs/api_reference_markdown/errors\",\"guardrails/docs/api_reference_markdown/formatters\",\"guardrails/docs/api_reference_markdown/generics_and_base_classes\",\"guardrails/docs/api_reference_markdown/guards\",\"guardrails/docs/api_reference_markdown/history_and_logs\",\"guardrails/docs/api_reference_markdown/llm_interaction\",\"guardrails/docs/api_reference_markdown/types\",\"guardrails/docs/api_reference_markdown/validator\"]},\"guardrails/docs/cli\",\"guardrails/docs/guardrails_server_api\"]}]}]},\"styling\":{\"latex\":true,\"codeblocks\":\"system\"}},\"docsNavWithMetadata\":{\"global\":{\"anchors\":[{\"anchor\":\"Blog\",\"icon\":\"newspaper\",\"href\":\"https://snowglobe.so/blog\"},{\"anchor\":\"Community\",\"icon\":\"discord\",\"href\":\"https://discord.gg/U9RKkZSBgx\"},{\"anchor\":\"Book Demo\",\"icon\":\"calendar\",\"href\":\"https://cal.com/team/snowglobe/demo\"}]},\"products\":[{\"product\":\"Snowglobe\",\"tabs\":[{\"tab\":\"Docs\",\"groups\":[{\"group\":\"Getting Started\",\"icon\":\"compass\",\"pages\":[{\"title\":\"Overview\",\"description\":\"A 60-second crash course on Snowglobe and simulation testing.\",\"href\":\"/snowglobe/docs/overview\"},{\"title\":\"Quickstart\",\"description\":\"Get started with Snowglobe in under 5 minutes.\",\"href\":\"/snowglobe/docs/quickstart\"},{\"title\":\"About AI Simulation Testing\",\"description\":\"Learn what AI simulation testing is, why manual testing falls short, and how Snowglobe helps you test AI agents at scale with personas, scenarios, and automated metrics.\",\"href\":\"/snowglobe/docs/about-sim-lifecycle\"},{\"title\":\"FAQ\",\"description\":\"Get answers to common questions about AI chat simulation, synthetic data generation, simulation testing, and RL finetuning data with Snowglobe.\",\"href\":\"/snowglobe/docs/faq\"}]},{\"group\":\"How-to Guides\",\"icon\":\"map\",\"pages\":[{\"title\":\"Connect Your Chatbot\",\"description\":\"How to connect your application to Snowglobe for simulation testing.\",\"href\":\"/snowglobe/docs/guide/connect-your-chatbot\"},{\"title\":\"Bootstrap with Claude Code\",\"description\":\"Use the snowglobe-skills plugin for Claude Code to set up a Snowglobe agent without writing the wrapper by hand.\",\"href\":\"/snowglobe/docs/guide/bootstrap-with-claude-code\"},{\"title\":\"Write Effective Chatbot Descriptions\",\"description\":\"Learn how to write clear, actionable chatbot descriptions that improve persona and scenario generation quality.\",\"href\":\"/snowglobe/docs/guide/write-chatbot-description\"},{\"title\":\"Define Simulation Prompt\",\"description\":\"How to clearly define what you want to test and achieve with your simulations\",\"href\":\"/snowglobe/docs/guide/define-sim-intent\"},{\"title\":\"Set Simulation Size\",\"description\":\"Learn how to choose the right number of personas, conversations, and conversation length for effective testing.\",\"href\":\"/snowglobe/docs/guide/set-sim-size\"},{\"title\":\"Create Custom Metrics\",\"description\":\"Build custom evaluation metrics tailored to your chatbot's specific requirements and use cases.\",\"href\":\"/snowglobe/docs/guide/create-custom-metric\"},{\"title\":\"Agent Profile Calibration\",\"description\":\"Automatically calibrate Snowglobe's tool mocking to match your agent's real tools, so simulations reflect production behavior.\",\"sidebarTitle\":\"Agent Profile Calibration\",\"href\":\"/snowglobe/docs/guide/agent-profile-calibration\"},{\"title\":\"Integrate with CI/CD\",\"description\":\"Automating Snowglobe testing in your development pipeline\",\"href\":\"/snowglobe/docs/guide/integrate-with-cicd\"}]},{\"group\":\"Examples \u0026 Showcase\",\"icon\":\"lightbulb\",\"pages\":[{\"title\":\"LLM Applications\",\"description\":\"Examples of testing Large Language Model applications with Snowglobe\",\"href\":\"/snowglobe/docs/examples/llm\"},{\"title\":\"Synchronous Connection Template\",\"description\":\"Learn how to implement a synchronous agent connection for Snowglobe testing using the sync template\",\"href\":\"/snowglobe/docs/examples/synchronous-connection\"},{\"title\":\"Asynchronous Connection Template\",\"description\":\"Learn how to implement an asynchronous agent connection for high-performance Snowglobe testing using the async template\",\"href\":\"/snowglobe/docs/examples/asynchronous-connection\"},{\"title\":\"Socket-Based Connection Template\",\"description\":\"Learn how to implement a socket-based agent connection for real-time Snowglobe testing using WebSocket connections\",\"href\":\"/snowglobe/docs/examples/socket-connection\"}]},{\"group\":\"Snowglobe Connect Reference\",\"icon\":\"square-terminal\",\"pages\":[{\"title\":\"Overview \u0026 Installation\",\"description\":\"Understand what `snowglobe-connect` is, when to use it, and the end-to-end flow to get your chatbot connected to Snowglobe.\",\"href\":\"/snowglobe/docs/connect/overview\"},{\"title\":\"`snowglobe-connect auth`\",\"description\":\"Authenticate the `snowglobe-connect` CLI with Snowglobe.\",\"href\":\"/snowglobe/docs/connect/authentication\"},{\"title\":\"`snowglobe-connect init`\",\"description\":\"Initialize a chatbot wrapper that you can fill in with your chatbot's details.\",\"href\":\"/snowglobe/docs/connect/chatbot-initialization\"},{\"title\":\"`snowglobe-connect test`\",\"description\":\"Test that your chatbot wrapper is set up correctly and accepts and returns messages in the correct format.\",\"href\":\"/snowglobe/docs/connect/test-your-wrapper\"},{\"title\":\"`snowglobe-connect start`\",\"description\":\"Start a Snowglobe session with your chatbot connected to it.\",\"href\":\"/snowglobe/docs/connect/connect-to-snowglobe\"},{\"title\":\"`snowglobe-connect simulate`\",\"description\":\"Launch a new simulation and start a Snowglobe session with your chatbot connected to that simulation.\",\"href\":\"/snowglobe/docs/connect/launch-a-simulation\"},{\"title\":\"`snowglobe-connect select-organization`\",\"description\":\"Sets a default organization for Snowglobe sessions.\"