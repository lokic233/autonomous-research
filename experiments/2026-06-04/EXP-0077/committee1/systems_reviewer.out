  {system: "Hugging Face datasets issue/PR", url: "https://github.com/huggingface/datasets/issues/6252 / https://github.com/huggingface/datasets/pull/6739", overlap: "Medium: upstream already recognized EXIF orientation causing task inconsistency and shipped EXIF transpose; does not claim serialization-time mirror score fork."},
