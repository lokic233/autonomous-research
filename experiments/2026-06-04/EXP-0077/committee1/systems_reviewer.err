    "comments": 2,
    "created_at": "2023-09-21T08:11:46Z",
    "updated_at": "2024-03-19T15:29:43Z",
    "closed_at": "2024-03-19T15:29:43Z",
    "assignee": null,
    "author_association": "NONE",
    "issue_field_values": [],
    "type": null,
    "active_lock_reason": null,
    "sub_issues_summary": {
