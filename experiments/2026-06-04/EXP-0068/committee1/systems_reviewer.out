EXISTING_IMPLEMENTATIONS: [
  {system: "datatrove MinHash dedup", url: "https://github.com/huggingface/datatrove/blob/main/src/datatrove/pipeline/dedup/minhash.py", overlap: "Ships MinHash+LSH with TextNormConfig and simplify_text preprocessing; default lowercases, normalizes whitespace/numbers, strips punctuation/diacritics via NFD. No evidence of model-tokenizer normalizer import/alignment or NFKC+casefold default."},
  {system: "text-dedup", url: "https://github.com/ChenghaoMou/text-dedup/blob/main/src/text_dedup/config/algorithms/minhash.py", overlap: "MinHash tokenizer lowercases and splits on non-word chars; utility normalize() lowercases/digit/punctuation-normalizes, but MinHash path does not expose model-normalizer alignment or NFKC+casefold."},
  {system: "NeMo Curator fuzzy dedup", url: "https://github.com/NVIDIA/NeMo-Curator/blob/main/nemo_curator/stages/deduplication/fuzzy/minhash.py", overlap: "GPU MinHash over cuDF string minhash with char ngrams; fuzzy workflow config exposes ngram/hash/band fields, not tokenizer-normalizer alignment."},
  {system: "NeMo Curator UnicodeReformatter", url: "https://github.com/NVIDIA/NeMo-Curator/blob/main/nemo_curator/stages/text/modifiers/unicode/unicode_reformatter.py", overlap: "Separate cleaning stage can apply NFC/NFD/NFKC/NFKD through ftfy, but it is not co-owned by fuzzy dedup as a model-aware alignment mode and does not provide casefold alignment."},
  {system: "BigCode near dedup", url: "https://github.com/bigcode-project/bigcode-dataset/blob/main/near_deduplication/minhash_deduplication.py", overlap: "Production-scale MinHash+LSH pipeline using NON_ALPHA tokenization; no model-tokenizer normalizer alignment found."}
