tems.\",\"href\":\"/docs/sglang-diffusion/profiling\"},{\"title\":\"CI Performance Baselines\",\"description\":\"Generate and update diffusion performance baselines used in CI.\",\"href\":\"/docs/sglang-diffusion/ci_perf\"}]},{\"group\":\"Caching Strategies\",\"pages\":[{\"title\":\"Caching Acceleration\",\"description\":\"Compare caching acceleration strategies for diffusion models.\",\"href\":\"/docs/sglang-diffusion/caching-acceleration\"},{\"title\":\"Cache-DiT Acceleration\",\"description\":\"Configure Cache-DiT acceleration for diffusion inference.\",\"href\":\"/docs/sglang-diffusion/cache_dit\"},{\"title\":\"TeaCache Acceleration\",\"description\":\"Configure TeaCache for temporal similarity-based diffusion acceleration.\",\"href\":\"/docs/sglang-diffusion/teacache\"}]},{\"group\":\"References\",\"pages\":[{\"title\":\"Environment Variables\",\"description\":\"Configure SGLang diffusion behavior with environment variables.\",\"href\":\"/docs/sglang-diffusion/environment_variables\"},{\"title\":\"How to Support New Diffusion Models\",\"metatags\":{\"description\":\"This document explains how to add support for new diffusion models in SGLang Diffusion.\"},\"description\":null,\"href\":\"/docs/sglang-diffusion/support_new_models\"},{\"title\":\"Contributing to SGLang Diffusion\",\"metatags\":{\"description\":\"This guide outlines the requirements for contributing to the SGLang Diffusion module (sglang.multimodalgen).\"},\"description\":null,\"href\":\"/docs/sglang-diffusion/contributing\"}]}]}]}]},\"anonymizedNav\":\"$undefined\"},\"children\":\"$L36\"}]}]}]}]]}]}]]\n"])</script><script>self.__next_f.push([1,"37:I[604804,[\"/mintlify-assets/_next/static/chunks/321c1fa0f04d01df.js?dpl=dpl_7exBNnC3CGWkHjTFkbtXvy4UWkHf\",\"/mintlify-assets/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_7exBNnC3CGWkHjTFkbtXvy4UWkHf\",\"/mintlify-assets/_next/static/chunks/44f01ef68ed4db4f.js?dpl=dpl_7exBNnC3CGWkHjTFkbtXvy4UWkHf\",\"/mintlify-assets/_next/static/chunks/90079180db6f1