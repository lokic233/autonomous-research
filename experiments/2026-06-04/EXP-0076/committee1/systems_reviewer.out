ROLE: systems_reviewer  VOTE: yellow
PROMPT_VERSION: v001
EXISTING_IMPLEMENTATIONS: [
  {system: "lossless-json", url: "https://github.com/josdejong/lossless-json", overlap: "High as prior implementation of parse-time number preservation; README says JSON.parse loses digits, LosslessJSON parses numbers as LosslessNumber/BigInt and can reject unsafe conversion. Not wired into AI SDK default."},
  {system: "json-bigint", url: "https://github.com/sidorares/json-bigint", overlap: "High as prior implementation of BigInt/BigNumber JSON parsing; README explicitly demonstrates JSON.parse rounding 9223372036854775807 and JSONbig preserving it."},
  {system: "secure-json-parse", url: "https://github.com/fastify/secure-json-parse", overlap: "Target layer, not a fix: current code calls JSON.parse(text, reviver), then scans prototype/constructor keys."},
  {system: "Vercel AI SDK provider-utils", url: "https://github.com/vercel/ai/blob/main/packages/provider-utils/src/parse-json.ts", overlap: "Target layer, not a fix: parseJSON/safeParseJSON call secureJsonParse before schema validation."},
  {system: "mcp-to-ai-sdk + json-schema-to-zod", url: "https://github.com/vercel-labs/mcp-to-ai-sdk/blob/main/lib/tool-generator.ts", overlap: "Weakens default-prevalence claim: generator delegates to json-schema-to-zod; json-schema-to-zod@2.6.1 maps JSON Schema type integer to z.number().int(), and number format int64 to .int(), which current Zod rejects unsafe integers."},
  {system: "vLLM tool calling", url: "https://github.com/vllm-project/vllm/blob/main/docs/features/tool_calling.md", overlap: "Adjacent OSS system searched. It documents Python json.loads(tool_call.arguments) and structured-output modes; no evidence of the JS z.number()/secure-json-parse seam."},
  {system: "SGLang structured outputs", url: "https://docs.sglang.io/docs/advanced_features/structured_outputs", overlap: "Adjacent OSS system searched. It supports JSON schema/Pydantic validation in Python; no evidence of the JS float64 parse + Zod default seam."},
  {system: "Triton/TensorRT-LLM OpenAI frontend", url: "https://docs.nvidia.com/deeplearning/triton-inference-server/user-guide/docs/client_guide/openai_readme.html#tool-calling", overlap: "Adjacent OSS system searched. Docs show Python json.loads(function_arguments) and guided decoding for named calls; no evidence of this JS-stack failure mode."}
