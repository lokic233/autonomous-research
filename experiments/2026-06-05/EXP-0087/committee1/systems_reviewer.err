impl CongestionControl {
    pub const DEFAULT: Self = Self::Drop;

    #[cfg(feature = "internal")]
    pub const DEFAULT_PUSH: Self = Self::Drop;
    #[cfg(not(feature = "internal"))]
    pub(crate) const DEFAULT_PUSH: Self = Self::Drop;

