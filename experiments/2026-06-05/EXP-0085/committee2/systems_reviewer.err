      "id": 4644332,
      "node_id": "MDQ6VXNlcjQ2NDQzMzI=",
      "avatar_url": "https://avatars.githubusercontent.com/u/4644332?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/inkeliz",
      "html_url": "https://github.com/inkeliz",
      "followers_url": "https://api.github.com/users/inkeliz/followers",
      "following_url": "https://api.github.com/users/inkeliz/following{/other_user}",
      "gists_url": "https://api.github.com/users/inkeliz/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/inkeliz/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/inkeliz/subscriptions",
      "organizations_url": "https://api.github.com/users/inkeliz/orgs",
      "repos_url": "https://api.github.com/users/inkeliz/repos",
      "events_url": "https://api.github.com/users/inkeliz/events{/privacy}",
      "received_events_url": "https://api.github.com/users/inkeliz/received_events",
      "type": "User",
