ROLE: systems_reviewer  VOTE: yellow
EXISTING_IMPLEMENTATIONS: [
  {system: "vLLM structured outputs", url: "https://raw.githubusercontent.com/vllm-project/vllm/main/docs/features/structured_outputs.md", overlap: "Implements hard constrained outputs: `choice` output is exactly one of choices; `json` follows JSON schema; uses xgrammar/llguidance backends. This is the substrate for enum support-removal."},
  {system: "vLLM tool calling", url: "https://raw.githubusercontent.com/vllm-project/vllm/main/docs/features/tool_calling.md", overlap: "Named/required tool calling uses structured outputs; docs explicitly warn it guarantees valid parseable function calls, not high-quality ones, and `required` forces at least one tool call."},
  {system: "SGLang structured outputs", url: "https://docs.sglang.io/docs/advanced_features/structured_outputs.md", overlap: "Guarantees output follows JSON schema/regex/EBNF; examples include JSON-schema enum in tool parameters; supports XGrammar/Outlines/llguidance."},
  {system: "TensorRT-LLM guided decoding", url: "https://nvidia.github.io/TensorRT-LLM/latest/features/guided-decoding.html", overlap: "Guided/constrained decoding guarantees outputs satisfy user grammar such as JSON schema/regex/EBNF via XGrammar or LLGuidance."},
  {system: "Grammar-Aligned Decoding / ASAp", url: "https://arxiv.org/abs/2405.21047", overlap: "Addresses distribution distortion under grammar constraints and samples from the LM distribution conditioned on the grammar; does not recover outputs with zero grammar support."}
