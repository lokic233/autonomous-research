ROLE: systems_reviewer  VOTE: red
PROMPT_VERSION: v001
EXISTING_IMPLEMENTATIONS: [
  {system: "Redis Agent Memory Server", url: "https://github.com/redis/agent-memory-server/blob/main/agent_memory_server/long_term_memory.py", overlap: "Direct overlap: store-time long-term-memory deduplication has id, hash, and semantic vector-search dedup before indexing; semantic duplicates are merged, with configurable distance threshold. Docs also advertise hash-based and semantic dedup: https://github.com/redis/agent-memory-server/blob/main/docs/long-term-memory.md"},
  {system: "Redis Agent Memory Server tests", url: "https://github.com/redis/agent-memory-server/blob/main/tests/integration/test_deduplication_e2e.py", overlap: "Shipping artifact tests paraphrased memories being merged rather than stored as duplicates, distinct memories not merged, and threshold behavior."},
  {system: "Mem0", url: "https://github.com/mem0ai/mem0/blob/main/mem0/memory/main.py", overlap: "Partial overlap: add path retrieves existing similar memories, uses LLM extraction/conflict handling, and performs hash dedup before vector-store insert. Not the same cheap no-LLM semantic gate, but already implements write-path memory dedup/consolidation machinery."},
  {system: "Letta/MemGPT", url: "https://github.com/letta-ai/letta/blob/main/letta/services/passage_manager.py", overlap: "Agent archival memory write path exists with embeddings and persistent storage, but I found no comparable pre-write semantic dedup in the passage insert path; mainly establishes that production agent memory write/eviction surfaces already exist."},
