  {system: "vLLM Automatic Prefix Caching", url: "https://docs.vllm.ai/en/latest/design/prefix_caching/", overlap: "Low/medium systems overlap: shipping hash-block prefix reuse with free-queue/LRU-style eviction; no semantic tool-result future-reference retention."},
  {system: "SGLang RadixAttention", url: "https://github.com/sgl-project/sglang", overlap: "Low/medium systems overlap: prefix/radix cache reuse and cache-aware serving, not per-span delayed-reference prediction."},
  {system: "LMCache", url: "https://github.com/LMCache/LMCache", overlap: "Low/medium systems overlap: reusable-text KV cache across GPU/CPU/disk/S3 with vLLM/SGLang integration; not selecting committed tool-result spans by predicted future use."},
