  {system: "OpenCompass MATHVerifyEvaluator", url: "https://github.com/open-compass/opencompass/blob/main/opencompass/evaluator/math_evaluator.py", overlap: "Uses math_verify parse/verify and boxed extraction for math scoring; overlaps with symbolic answer equivalence, not self-consistency bucket dynamics."},
  {system: "EleutherAI lm-evaluation-harness Minerva MATH utils", url: "https://github.com/EleutherAI/lm-evaluation-harness/blob/main/lm_eval/tasks/minerva_math/utils.py", overlap: "Implements Minerva-style answer normalization plus SymPy/math_verify scoring; overlaps with canonicalization/equivalence, not recall-as-treatment or ranking-hazard analysis."},
  {system: "Google Minerva", url: "https://research.google/blog/minerva-solving-quantitative-reasoning-problems-with-language-models/", overlap: "Uses majority voting over sampled solutions and most-common final answer; overlaps with maj@k/self-consistency, but does not analyze canonicalizer recall sign flips."},
  {system: "vLLM", url: "https://github.com/vllm-project/vllm", overlap: "Inference/serving engine with structured outputs; no found implementation of answer-equivalence majority voting hazard."},
  {system: "SGLang", url: "https://github.com/sgl-project/sglang", overlap: "High-performance serving framework; no found implementation of this evaluator mechanism."},
  {system: "LMCache", url: "https://github.com/LMCache/LMCache", overlap: "KV-cache serving extension; no substantive overlap with answer canonicalization or maj@k scoring."},
  {system: "FlashInfer", url: "https://github.com/flashinfer-ai/flashinfer", overlap: "GPU inference kernels and sampling primitives; no evaluator/canonicalizer overlap."},
