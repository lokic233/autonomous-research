"},{\"source\":\"/diffusion.html\",\"destination\":\"/docs/sglang-diffusion/index\"}],\"contextual\":{\"options\":[\"copy\",\"view\",\"chatgpt\",\"claude\",\"perplexity\",\"mcp\",\"cursor\",\"vscode\"],\"display\":\"header\"},\"styling\":{\"latex\":true,\"codeblocks\":\"system\"}},\"docsNavWithMetadata\":{\"global\":{\"anchors\":[]},\"tabs\":[{\"tab\":\"Get Started\",\"groups\":[{\"group\":\"Get Started\",\"icon\":\"play\",\"pages\":[{\"title\":\"Welcome to SGLang\",\"description\":\"High-performance serving framework for large language and multimodal models.\",\"keywords\":[\"sglang\",\"llm serving\",\"multimodal\",\"inference runtime\"],\"mode\":\"wide\",\"href\":\"/index\"},{\"title\":\"Installation\",\"description\":\"Install SGLang with pip/uv, source, Docker, Kubernetes, and cloud deployment options.\",\"keywords\":[\"installation\",\"sglang\",\"pip\",\"docker\"],\"href\":\"/docs/get-started/install\"},{\"title\":\"Quickstart\",\"description\":\"Get up and running with SGLang in minutes: install, launch a server, and send your first request.\",\"href\":\"/docs/get-started/quickstart\"},{\"title\":\"Tutorial: Sending a request\",\"metatags\":{\"description\":\"This notebook provides a quick-start guide to use SGLang in chat completions after installation. \"},\"description\":null,\"href\":\"/docs/basic_usage/send_request\"}]}]},{\"tab\":\"User Guide\",\"groups\":[{\"group\":\"Basic Usage\",\"icon\":\"book-open\",\"pages\":[{\"title\":\"Basic Usage\",\"description\":\"Core APIs and common usage patterns for SGLang.\",\"href\":\"/docs/basic_usage/overview\"},{\"group\":\"OpenAI-Compatible APIs\",\"pages\":[{\"title\":\"OpenAI-Compatible APIs\",\"description\":\"Documentation for OpenAI-Compatible APIs\",\"href\":\"/docs/basic_usage/openai_api\"},{\"title\":\"OpenAI APIs - Completions\",\"metatags\":{\"description\":\"This tutorial covers the following popular APIs: 'chat/completions' and 'completions'\"},\"description\":null,\"href\":\"/docs/basic_usage/openai_api_completions\"},{\"title\":\"OpenAI APIs - Vision\",\"metatags\":{\"description\":\"This tutorial covers the vision APIs for vision language models.\"},\"description\":null,\"href\":\"/docs/basic_usage/openai_api_vision\"},{\"title\":\"OpenAI APIs - Embedding\",\"metatags\":{\"description\":\"This tutorial covers the embedding APIs for embedding models.\"},\"description\":null,\"href\":\"/docs/basic_usage/openai_api_embeddings\"}]},{\"title\":\"Ollama-Compatible API\",\"metatags\":{\"description\":\"SGLang provides Ollama API compatibility, allowing you to use the Ollama CLI and Python library with SGLang as the inference backend.\"},\"description\":null,\"href\":\"/docs/basic_usage/ollama_api\"},{\"title\":\"Offline Engine API\",\"metatags\":{\"description\":\"Use SGLang's offline engine for direct batch inference without HTTP server overhead. Supports sync/async and streaming modes.\"},\"description\":null,\"href\":\"/docs/basic_usage/offline_engine_api\"},{\"title\":\"SGLang Native APIs\",\"metatags\":{\"description\":\"SGLang native server APIs for text generation, embedding, reranking, model info, cache management, and more.\"},\"description\":null,\"href\":\"/docs/basic_usage/native_api\"},{\"title\":\"Sampling Parameters\",\"metatags\":{\"description\":\"Complete reference for SGLang sampling parameters: temperature, top_p, top_k, frequency penalty, stop tokens, and more.\"},\"description\":null,\"href\":\"/docs/basic_usage/sampling_params\"}]},{\"group\":\"Advanced Features\",\"icon\":\"gears\",\"pages\":[{\"title\":\"Advanced Features\",\"description\":\"Advanced configuration, optimization, and deployment features for SGLang.\",\"href\":\"/docs/advanced_features/overview\"},{\"title\":\"Server Arguments\",\"metatags\":{\"description\":\"SGLang server arguments: model selection, TP/DP parallelism, memory management, quantization, logging, and optimization options.\"},\"description\":null,\"href\":\"/docs/advanced_features/server_arguments\"},{\"title\":\"Loading Models from Object Storage\",\"metatags\":{\"description\":\"Load SGLang models directly from S3, Google Cloud Storage, Azure Blob, and S3-compatible object storage with runai_streamer.\"},\"description\":null,\"href\":\"/docs/advanced_features/object_storage\"},{\"title\":\"Hyperparameter Tuning\",\"metatags\":{\"description\":\"SGLang performance tuning: batch size, token usage, mem-fraction-static, chunked-prefill-size, CUDA graph, DP/TP optimization.\"},\"description\":null,\"href\":\"/docs/advanced_features/hyperparameter_tuning\"},{\"title\":\"Attention Backend\",\"metatags\":{\"description\":\"SGLang attention backend guide: FlashInfer, FA3, FA4, Triton, FlashMLA, TRTLLM MLA, hybrid attention. Support matrix for MHA and MLA models.\"},\"description\":null,\"href\":\"/docs/advanced_features/attention_backend\"},{\"title\":\"HiSparse: Hierarchical Sparse Attention\",\"metatags\":{\"description\":\"Use HiSparse hierarchical sparse attention to reduce decode GPU KV memory with CPU pinned host storage and PD disaggregation.\"},\"description\":null,\"href\":\"/docs/advanced_features/hisparse_guide\"},{\"title\":\"Speculative Decoding\",\"metatags\":{\"description\":\"SGLang speculative decoding: EAGLE-2/EAGLE-3, MTP, DFLASH, draft model configuration, and overlap-scheduler guidance.\"},\"description\":null,\"href\":\"/docs/advanced_features/speculative_decoding\"},{\"title\":\"Adaptive Speculative Decoding\",\"metatags\":{\"description\":\"Configure adaptive speculative decoding so SGLang can adjust speculative steps and draft tokens at runtime based on acceptance behavior.\"},\"description\":null,\"href\":\"/docs/advanced_features/adaptive_speculative_decoding\"},{\"title\":\"Structured Outputs\",\"metatags\":{\"description\":\"SGLang structured outputs: JSON schema, regex, EBNF constraints. XGrammar, Outlines, Llguidance backends for guaranteed output format.\"},\"description\":null,\"href\":\"/docs/advanced_features/structured_outputs\"},{\"title\":\"Structured Outputs For Reasoning Models\",\"metatags\":{\"description\":\"SGLang structured outputs for reasoning models: free-form thinking with constrained final output for DeepSeek R1, QwQ models.\"},\"description\":null,\"href\":\"/docs/advanced_features/structured_outputs_for_reasoning_models\"},{\"title\":\"Tool Parser\",\"metatags\":{\"description\":\"SGLang function calling: tool parsers for DeepSeek, Llama, Qwen, Mistral, GLM, Kimi K2. OpenAI-compatible tool use API.\"},\"description\":null,\"href\":\"/docs/advanced_features/tool_parser\"},{\"title\":\"Reasoning Parser\",\"metatags\":{\"description\":\"SGLang reasoning parser: separate thinking content from output for DeepSeek R1, Qwen3, Kimi K2, GPT-OSS reasoning models.\"},\"description\":null,\"href\":\"/docs/advanced_features/separate_reasoning\"},{\"title\":\"Quantization\",\"metatags\":{\"description\":\"SGLang quantization: FP8, FP4, AWQ, GPTQ, ModelOpt, torchao. Offline and online quantization methods for efficient LLM inference.\"},\"description\":null,\"href\":\"/docs/advanced_features/quantization\"},{\"title\":\"Quantized KV Cache\",\"metatags\":{\"description\":\"SGLang quantized KV cache: FP8 E4M3/E5M2 and FP4 E2M1 formats, memory savings up to 3.56x, scaling factors, accuracy benchmarks.\"},\"description\":null,\"href\":\"/docs/advanced_features/quantized_kv_cache\"},{\"title\":\"DP, DPA and SGLang DP Router\",\"metatags\":{\"description\":\"Learn the differences between Data Parallelism, Data Parallelism Attention, and SGLang Model Gateway routing for production DP deployments.\"},\"description\":null,\"href\":\"/docs/advanced_features/dp_dpa_smg_guide\"},{\"title\":\"Expert Parallelism\",\"metatags\":{\"description\":\"SGLang Expert Parallelism: distribute MoE experts across GPUs, DeepEP all-to-all, grouped GEMMs, TBO/SBO overlap, EPLB load balancing.\"},\"description\":null,\"href\":\"/docs/advanced_features/expert_parallelism\"},{\"title\":\"LoRA Serving\",\"metatags\":{\"description\":\"SGLang multi-LoRA serving: S-LoRA and Punica techniques, dynamic adapter loading, GPU pinning, overlap loading, Triton and CSGMV backends.\"},\"description\":null,\"href\":\"/docs/advanced_features/lora\"},{\"title\":\"PD Disaggregation\",\"metatags\":{\"description\":\"SGLang PD disaggregation: separate prefill and decode phases, Mooncake and NIXL transfer engines, multi-node DeepSeek deployment.\"},\"description\":null,\"href\":\"/docs/advanced_features/pd_disaggregation\"},{\"title\":\"EPD Disaggregation\",\"metatags\":{\"description\":\"SGLang EPD disaggregation: separate encoder, prefill, decode stages for VLM inference. Independent scaling, load balancing, three-tier architecture.\"},\"description\":null,\"href\":\"/docs/advanced_features/epd_disaggregation\"},{\"title\":\"Pipeline Parallelism for Long Context\",\"metatags\":{\"description\":\"SGLang pipeline parallelism: reduce TTFT for ultra-long sequences, dynamic chunking, async P2P communication, multi-node deployment.\"},\"description\":null,\"href\":\"/docs/advanced_features/pipeline_parallelism\"},{\"group\":\"Hierarchical KV Caching (HiCache)\",\"pages\":[{\"title\":\"Hierarchical KV Caching (HiCache)\",\"metatags\":{\"description\":\"SGLang HiCache: three-tier KV caching (GPU, CPU, storage) for long-context and multi-turn inference. Supports Mooncake, 3FS, NIXL backends.\"},\"description\":null,\"href\":\"/docs/advanced_features/hicache\"},{\"title\":\"SGLang HiCache Best Practices\",\"metatags\":{\"description\":\"HiCache configuration guide: memory layout, prefetch policies, PD disaggregation, HF3FS and Mooncake deployment, custom storage backends.\"},\"description\":null,\"href\":\"/docs/advanced_features/hicache_best_practices\"},{\"title\":\"HiCache System Design and Optimization\",\"metatags\":{\"description\":\"HiCache architecture: HiRadixTree metadata, L1/L2/L3 workflow, prefetch strategies, write-back policies, zero-copy transfers, multi-rank sync.\"},\"description\":null,\"href\":\"/docs/advanced_features/hicache_design\"},{\"title\":\"Runtime Attach/Detach HiCache Storage Backend (No Restart)\",\"metatags\":{\"description\":\"Dynamically attach/detach HiCache L3 storage backends at runtime via HTTP API. No restart required, idle-state safety checks.\"},\"description\":null,\"href\":\"/docs/advanced_features/hicache_storage_runtime_attach_detach\"}]},{\"title\":\"Query VLM with Offline Engine\",\"metatags\":{\"description\":\"SGLang VLM offline engine: raw images, processor output, precomputed embeddings. Qwen2.5-VL and Llama 4 examples.\"},\"description\":null,\"href\":\"/docs/advanced_features/vlm_query\"},{\"title\":\"DP for Multi-Modal Encoder in SGLang\",\"metatags\":{\"description\":\"Data parallelism for VLM vision encoder in SGLang: reduce TTFT, boost throughput. Supports Qwen2.5-VL, Qwen3-VL, InternVL, GLM-4.5V/4.6V.\"},\"description\":null,\"href\":\"/docs/advanced_features/dp_for_multi_modal_encoder\"},{\"title\":\"Cuda Graph for Multi-Modal Encoder in SGLang\",\"metatags\":{\"description\":\"CUDA Graph optimization for ViT in SGLang: reduce kernel launch overhead, dynamic input handling, support for Qwen2.5-VL and Qwen3-VL models.\"},\"description\":null,\"href\":\"/docs/advanced_features/cuda_graph_for_multi_modal_encoder\"},{\"title\":\"Breakable CUDA Graph\",\"metatags\":{\"description\":\"Use Breakable CUDA Graph to insert targeted eager graph breaks for debugging and CUDA graph compatibility.\"},\"description\":null,\"href\":\"/docs/advanced_features/breakable_cuda_graph\"},{\"title\":\"Piecewise CUDA Graph\",\"metatags\":{\"description\":\"Use Piecewise CUDA Graph to reduce prefill and extend kernel launch overhead while supporting dynamic token shapes.\"},\"description\":null,\"href\":\"/docs/advanced_features/piecewise_cuda_graph\"},{\"title\":\"SGLang Model Gateway\",\"metatags\":{\"description\":\"SGLang Model Gateway: load balancing, PD disaggregation, multi-model routing, gRPC support, MCP integration, Kubernetes service discovery.\"},\"description\":null,\"href\":\"/docs/advanced_features/sgl_model_gateway\"},{\"title\":\"Deterministic Inference\",\"metatags\":{\"description\":\"SGLang deterministic inference: consistent outputs for RL training, testing, and production. Supports FlashInfer, FA3, Triton backends with CUDA Graph.\"},\"description\":null,\"href\":\"/docs/advanced_features/deterministic_inference\"},{\"title\":\"Observability\",\"metatags\":{\"description\":\"SGLang observability: Prometheus metrics, request logging, request dump and replay, crash dump debugging.\"},\"description\":null,\"href\":\"/docs/advanced_features/observability\"},{\"title\":\"Checkpoint Engine Integration\",\"metatags\":{\"description\":\"SGLang checkpoint engine: distributed model weight loading, parallel multi-node setup, broadcast and P2P modes. Reduces loading time for large models.\"},\"description\":null,\"href\":\"/docs/advanced_features/checkpoint_engine\"},{\"title\":\"SGLang for RL Systems\",\"metatags\":{\"description\":\"SGLang for RL: engine sleep/wake, weight refit, partial rollout, deterministic inference, cache-aware load balancing for RLHF.\"},\"description\":null,\"href\":\"/docs/advanced_features/sglang_for_rl\"}]},{\"group\":\"Supported Models\",\"icon\":\"cubes\",\"pages\":[{\"title\":\"Supported models\",\"description\":\"See which families of SGLang-compatible models are actively maintained.\",\"mode\":\"wide\",\"href\":\"/docs/supported-models\"},{\"group\":\"Text Generation\",\"pages\":[{\"title\":\"Large Language Models\",\"description\":null,\"href\":\"/docs/supported-models/generative_models\"},{\"title\":\"Multimodal Language Models\",\"metatags\":{\"description\":\"Documentation for Multimodal Language Models\"},\"description\":null,\"href\":\"/docs/supported-models/multimodal_language_models\"},{\"title\":\"Diffusion language models\",\"description\":null,\"href\":\"/docs/supported-models/diffusion_language_models\"}]},{\"group\":\"Retrieval and Ranking\",\"pages\":[{\"title\":\"Embedding models\",\"description\":\"Dense and sparse embedding models with FlashInfer acceleration and SGLang's batching infrastructure.\",\"href\":\"/docs/supported-models/embedding_models\"},{\"title\":\"Rerank models\",\"description\":null,\"href\":\"/docs/supported-models/rerank_models\"},{\"title\":\"Classification Models\",\"description\":null,\"href\":\"/docs/supported-models/classify_models\"}]},{\"group\":\"Specialized Models\",\"pages\":[{\"title\":\"Reward models\",\"description\":null,\"href\":\"/docs/supported-models/reward_models\"}]},{\"group\":\"Extending SGLang\",\"pages\":[{\"title\":\"How to Support New Models\",\"description\":\"This document explains how to add support for new language models and multimodal large language models (MLLMs) in SGLang. It also covers how to test new models and register external implementations.\",\"href\":\"/docs/supported-models/support_new_models\"},{\"title\":\"Transformers Fallback in SGLang\",\"description\":null,\"href\":\"/docs/supported-models/transformers_fallback\"},{\"title\":\"Use Models From ModelScope\",\"description\":null,\"href\":\"/docs/supported-models/modelscope\"},{\"title\":\"MindSpore Models\",\"description\":null,\"href\":\"/docs/supported-models/mindspore_models\"}]}]},{\"group\":\"Developer Guide\",\"icon\":\"code\",\"pages\":[{\"title\":\"Developer Guide\",\"description\":\"Contributing to SGLang — development setup, benchmarking, and evaluation.\",\"href\":\"/docs/developer_guide/overview\"},{\"title\":\"Contribution Guide\",\"mode\":\"wide\",\"metatags\":{\"description\":\"SGLang contribution guide: source install, pre-commit, unit tests, CI triggers, code style, sgl-kernel updates.\"},\"description\":null,\"href\":\"/docs/developer_guide/contribution_guide\"},{\"group\":\"Development\",\"pages\":[{\"title\":\"Development Guide Using Docker\",\"sidebarTitle\":\"Using Docker\",\"metatags\":{\"description\":\"SGLang Docker development: VSCode dev container, remote tunnels, debugger 