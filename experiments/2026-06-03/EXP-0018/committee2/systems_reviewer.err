/vllm/v1/worker/gpu/model_states/default/ class=md-nav__link> <span class=md-ellipsis> default </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/model_states/interface/ class=md-nav__link> <span class=md-ellipsis> interface </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/model_states/mamba_hybrid/ class=md-nav__link> <span class=md-ellipsis> mamba_hybrid </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/model_states/whisper/ class=md-nav__link> <span class=md-ellipsis> whisper </span> </a> </li> </ul> </nav> </li> <li class="md-nav__item md-nav__item--nested"> <input class="md-nav__toggle md-toggle " type=checkbox id=__nav_5_2_51_19_26_22> <div class="md-nav__link md-nav__container"> <a href=../../api/vllm/v1/worker/gpu/pool/ class="md-nav__link "> <span class=md-ellipsis> pool </span> </a> <label class="md-nav__link " for=__nav_5_2_51_19_26_22 id=__nav_5_2_51_19_26_22_label tabindex=0> <span class="md-nav__icon md-icon"></span> </label> </div> <nav class=md-nav data-md-level=6 aria-labelledby=__nav_5_2_51_19_26_22_label aria-expanded=false> <label class=md-nav__title for=__nav_5_2_51_19_26_22> <span class="md-nav__icon md-icon"></span> pool </label> <ul class=md-nav__list data-md-scrollfix> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/pool/late_interaction_runner/ class=md-nav__link> <span class=md-ellipsis> late_interaction_runner </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/pool/pooling_runner/ class=md-nav__link> <span class=md-ellipsis> pooling_runner </span> </a> </li> </ul> </nav> </li> <li class="md-nav__item md-nav__item--nested"> <input class="md-nav__toggle md-toggle " type=checkbox id=__nav_5_2_51_19_26_23> <div class="md-nav__link md-nav__container"> <a href=../../api/vllm/v1/worker/gpu/sample/ class="md-nav__link "> <span class=md-ellipsis> sample </span> </a> <label class="md-nav__link " for=__nav_5_2_51_19_26_23 id=__nav_5_2_51_19_26_23_label tabindex=0> <span class="md-nav__icon md-icon"></span> </label> </div> <nav class=md-nav data-md-level=6 aria-labelledby=__nav_5_2_51_19_26_23_label aria-expanded=false> <label class=md-nav__title for=__nav_5_2_51_19_26_23> <span class="md-nav__icon md-icon"></span> sample </label> <ul class=md-nav__list data-md-scrollfix> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/sample/bad_words/ class=md-nav__link> <span class=md-ellipsis> bad_words </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/sample/gumbel/ class=md-nav__link> <span class=md-ellipsis> gumbel </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/sample/logit_bias/ class=md-nav__link> <span class=md-ellipsis> logit_bias </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/sample/logprob/ class=md-nav__link> <span class=md-ellipsis> logprob </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/sample/min_p/ class=md-nav__link> <span class=md-ellipsis> min_p </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/sample/output/ class=md-nav__link> <span class=md-ellipsis> output </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/sample/penalties/ class=md-nav__link> <span class=md-ellipsis> penalties </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/sample/prompt_logprob/ class=md-nav__link> <span class=md-ellipsis> prompt_logprob </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/sample/sampler/ class=md-nav__link> <span class=md-ellipsis> sampler </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/sample/states/ class=md-nav__link> <span class=md-ellipsis> states </span> </a> </li> </ul> </nav> </li> <li class="md-nav__item md-nav__item--nested"> <input class="md-nav__toggle md-toggle " type=checkbox id=__nav_5_2