rted-models\"},{\"source\":\"/diffusion.html\",\"destination\":\"/docs/sglang-diffusion/index\"}],\"contextual\":{\"options\":[\"copy\",\"view\",\"chatgpt\",\"claude\",\"perplexity\",\"mcp\",\"cursor\",\"vscode\"],\"display\":\"header\"},\"styling\":{\"latex\":true,\"codeblocks\":\"system\"}},\"docsNavWithMetadata\":{\"global\":{\"anchors\":[]},\"tabs\":[{\"tab\":\"Get Started\",\"groups\":[{\"group\":\"Get Started\",\"icon\":\"play\",\"pages\":[{\"title\":\"Welcome to SGLang\",\"description\":\"High-performance serving framework for large language and multimodal models.\",\"keywords\":[\"sglang\",\"llm serving\",\"multimodal\",\"inference runtime\"],\"mode\":\"wide\",\"href\":\"/index\"},{\"title\":\"Installation\",\"description\":\"Install SGLang with pip/uv, source, Docker, Kubernetes, and cloud deployment options.\",\"keywords\":[\"installation\",\"sglang\",\"pip\",\"docker\"],\"href\":\"/docs/get-started/install\"},{\"title\":\"Quickstart\",\"description\":\"Get up and running with SGLang in minutes: install, launch a server, and send your first request.\",\"href\":\"/docs/get-started/quickstart\"},{\"title\":\"Tutorial: Sending a request\",\"metatags\":{\"description\":\"This notebook provides a quick-start guide to use SGLang in chat completions after installation. \"},\"description\":null,\"href\":\"/docs/basic_usage/send_request\"}]}]},{\"tab\":\"User Guide\",\"groups\":[{\"group\":\"Basic Usage\",\"icon\":\"book-open\",\"pages\":[{\"title\":\"Basic Usage\",\"description\":\"Core APIs and common usage patterns for SGLang.\",\"href\":\"/docs/basic_usage/overview\"},{\"group\":\"OpenAI-Compatible APIs\",\"pages\":[{\"title\":\"OpenAI-Compatible APIs\",\"description\":\"Documentation for OpenAI-Compatible APIs\",\"href\":\"/docs/basic_usage/openai_api\"},{\"title\":\"OpenAI APIs - Completions\",\"metatags\":{\"description\":\"This tutorial covers the following popular APIs: 'chat/completions' and 'completions'\"},\"description\":null,\"href\":\"/docs/basic_usage/openai_api_completions\"},{\"title\":\"OpenAI APIs - Vision\",\"metatags\":{\"description\":\"This tutorial covers the vision APIs for vision language models.\"},\"description\":null,\"href\":\"/docs/basic_usage/openai_api_vision\"},{\"title\":\"OpenAI APIs - Embedding\",\"metatags\":{\"description\":\"This tutorial covers the embedding APIs for embedding models.\"},\"description\":null,\"href\":\"/docs/basic_usage/openai_api_embeddings\"}]},{\"title\":\"Ollama-Compatible API\",\"metatags\":{\"description\":\"SGLang provides Ollama API compatibility, allowing you to use the Ollama CLI and Python library with SGLang as the inference backend.\"},\"description\":null,\"href\":\"/docs/basic_usage/ollama_api\"},{\"title\":\"Offline Engine API\",\"metatags\":{\"description\":\"Use SGLang's offline engine for direct batch inference without HTTP server overhead. Supports sync/async and streaming modes.\"},\"description\":null,\"href\":\"/docs/basic_usage/offline_engine_api\"},{\"title\":\"SGLang Native APIs\",\"metatags\":{\"description\":\"SGLang native server APIs for text generation, embedding, reranking, model info, cache management, and more.\"},\"description\":null,\"href\":\"/docs/basic_usage/native_api\"},{\"title\":\"Sampling Parameters\",\"metatags\":{\"description\":\"Complete reference for SGLang sampling parameters: temperature, top_p, top_k, frequency penalty, stop tokens, and more.\"},\"description\":null,\"href\":\"/docs/basic_usage/sampling_params\"}]},{\"group\":\"Advanced Features\",\"icon\":\"gears\",\"pages\":[{\"title\":\"Advanced Features\",\"description\":\"Advanced configuration, optimization, and deployment features for SGLang.\",\"href\":\"/docs/advanced_features/overview\"},{\"title\":\"Server Arguments\",\"metatags\":{\"description\":\"SGLang server arguments: model selection, TP/DP parallelism, memory management, quantization, logging, and optimization options.\"},\"description\":null,\"href\":\"/docs/advanced_features/server_arguments\"},{\"title\":\"Loading Models from Object Storage\",\"metatags\":{\"description\":\"Load SGLang models directly from S3, Google Cloud Storage, Azure Blob, and S3-compatible object storage with runai_streamer.\"},\"description\":null,\"href\":\"/docs/advanced_features/object_storage\"},{\"title\":\"Hyperparameter Tuning\",\"metatags\":{\"description\":\"SGLang performance tuning: batch size, token usage, mem-fraction-static, chunked-prefill-size, CUDA graph, DP/TP optimization.\"},\"description\":null,\"href\":\"/docs/advanced_features/hyperparameter_tuning\"},{\"title\":\"Attention Backend\",\"metatags\":{\"description\":\"SGLang attention backend guide: FlashInfer, FA3, FA4, Triton, FlashMLA, TRTLLM MLA, hybrid attention. Support matrix for MHA and MLA models.\"},\"description\":null,\"href\":\"/docs/advanced_features/attention_backend\"},{\"title\":\"HiSparse: Hierarchical Sparse Attention\",\"metatags\":{\"description\":\"Use HiSparse hierarchical sparse attention to reduce decode GPU KV memory with CPU pinned host storage and PD disaggregation.\"},\"description\":null,\"href\":\"/docs/advanced_features/hisparse_guide\"},{\"title\":\"Speculative Decoding\",\"metatags\":{\"description\":\"SGLang speculative decoding: EAGLE-2/EAGLE-3, MTP, DFLASH, draft model configuration, and overlap-scheduler guidance.\"},\"description\":null,\"href\":\"/docs/advanced_features/speculative_decoding\"},{\"title\":\"Adaptive Speculative Decoding\",\"metatags\":{\"description\":\"Configure adaptive speculative decoding so SGLang can adjust speculative steps and draft tokens at runtime based on acceptance behavior.\"},\"description\":null,\"href\":\"/docs/advanced_features/adaptive_speculative_decoding\"},{\"title\":\"Structured Outputs\",\"metatags\":{\"description\":\"SGLang structured outputs: JSON schema, regex, EBNF constraints. XGrammar, Outlines, Llguidance backends for guaranteed output format.\"},\"description\":null,\"href\":\"/docs/advanced_features/structured_outputs\"},{\"title\":\"Structured Outputs For Reasoning Models\",\"metatags\":{\"description\":\"SGLang structured outputs for reasoning models: free-form thinking with constrained final output for DeepSeek R1, QwQ models.\"},\"description\":null,\"href\":\"/docs/advanced_features/structured_outputs_for_reasoning_models\"},{\"title\":\"Tool Parser\",\"metatags\":{\"description\":\"SGLang function calling: tool parsers for DeepSeek, Llama, Qwen, Mistral, GLM, Kimi K2. OpenAI-compatible tool use API.\"},\"description\":null,\"href\":\"/docs/advanced_features/tool_parser\"},{\"title\":\"Reasoning Parser\",\"metatags\":{\"description\":\"SGLang reasoning parser: separate thinking content from output for DeepSeek R1, Qwen3, Kimi K2, GPT-OSS reasoning models.\"},\"description\":null,\"href\":\"/docs/advanced_features/separate_reasoning\"},{\"title\":\"Quantization\",\"metatags\":{\"description\":\"SGLang quantization: FP8, FP4, AWQ, GPTQ, ModelOpt, torchao. Offline and online quantization methods for efficient LLM inference.\"},\"description\":null,\"href\":\"/docs/advanced_features/quantization\"},{\"title\":\"Quantized KV Cache\",\"metatags\":{\"description\":\"SGLang quantized KV cache: FP8 E4M3/E5M2 and FP4 E2M1 formats, memory savings up to 3.56x, scaling factors, accuracy benchmarks.\"},\"description\":null,\"href\":\"/docs/advanced_features/quantized_kv_cache\"},{\"title\":\"DP, DPA and SGLang DP Router\",\"metatags\":{\"description\":\"Learn the differences between Data Parallelism, Data Parallelism Attention, and SGLang Model Gateway routing for production DP deployments.\"},\"description\":null,\"href\":\"/docs/advanced_features/dp_dpa_smg_guide\"},{\"title\":\"Expert Parallelism\",\"metatags\":{\"description\":\"SGLang Expert Parallelism: distribute MoE experts across GPUs, DeepEP all-to-all, grouped GEMMs, TBO/SBO overlap, EPLB load balancing.\"},\"description\":null,\"href\":\"/docs/advanced_features/expert_parallelism\"},{\"title\":\"LoRA Serving\",\"metatags\":{\"description\":\"SGLang multi-LoRA serving: S-LoRA and Punica techniques, dynamic adapter loading, GPU pinning, overlap loading, Triton and CSGMV backends.\"},\"description\":null,\"href\":\"/docs/advanced_features/lora\"},{\"title\":\"PD Disaggregation\",\"metatags\":{\"description\":\"SGLang PD disaggregation: separate prefill and decode phases, Mooncake and NIXL transfer engines, multi-node DeepSeek deployment.\"},\"description\":null,\"href\":\"/docs/advanced_features/pd_disaggregation\"},{\"title\":\"EPD Disaggregation\",\"metatags\":{\"description\":\"SGLang EPD disaggregation: separate encoder, prefill, decode stages for VLM inference. Independent scaling, load balancing, three-tier architecture.\"},\"description\":null,\"href\":\"/docs/advanced_features/epd_disaggregation\"},{\"title\":\"Pipeline Parallelism for Long Context\",\"metatags\":{\"description\":\"SGLang pipeline parallelism: reduce TTFT for ultra-long sequences, dynamic chunking, async P2P communication, multi-node deployment.\"},\"description\":null,\"href\":\"/docs/advanced_features/pipeline_parallelism\"},{\"group\":\"Hierarchical KV Caching (HiCache)\",\"pages\":[{\"title\":\"Hierarchical KV Caching (HiCache)\",\"metatags\":{\"description\":\"SGLang HiCache: three-tier KV caching (GPU, CPU, storage) for long-context and multi-turn inference. Supports Mooncake, 3FS, NIXL backends.\"},\"description\":null,\"href\":\"/docs/advanced_features/hicache\"},{\"title\":\"SGLang HiCache Best Practices\",\"metatags\":{\"description\":\"HiCache configuration guide: memory layout, prefetch policies, PD disaggregation, HF3FS and Mooncake deployment, custom storage backends.\"},\"description\":null,\"href\":\"/docs/advanced_features/hicache_best_practices\"},{\"title\":\"HiCache System Design and Optimization\",\"metatags\":{\"description\":\"HiCache architecture: HiRadixTree metadata, L1/L2/L3 workflow, prefetch strategies, write-back policies, zero-copy transfers, multi-rank sync.\"},\"description\":null,\"href\":\"/docs/advanced_features/hicache_design\"},{\"title\":\"Runtime Attach/Detach HiCache Storage Backend (No Restart)\",\"metatags\":{\"description\":\"Dynamically attach/detach HiCache L3 storage backends at runtime via HTTP API. No restart required, idle-state safety checks.\"},\"description\":null,\"href\":\"/docs/advanced_features/hicache_storage_runtime_attach_detach\"}]},{\"title\":\"Query VLM with Offline Engine\",\"metatags\":{\"description\":\"SGLang VLM offline engine: raw images, processor output, precomputed embeddings. Qwen2.5-VL and Llama 4 examples.\"},\"description\":null,\"href\":\"/docs/advanced_features/vlm_query\"},{\"title\":\"DP for Multi-Modal Encoder in SGLang\",\"metatags\":{\"description\":\"Data parallelism for VLM vision encoder in SGLang: reduce TTFT, boost throughput. Supports Qwen2.5-VL, Qwen3-VL, InternVL, GLM-4.5V/4.6V.\"},\"description\":null,\"href\":\"/docs/advanced_features/dp_for_multi_modal_encoder\"},{\"title\":\"Cuda Graph for Multi-Modal Encoder in SGLang\",\"metatags\":{\"description\":\"CUDA Graph optimization for ViT in SGLang: reduce kernel launch overhead, dynamic input handling, support for Qwen2.5-VL and Qwen3-VL models.\"},\"description\":null,\"href\":\"/docs/advanced_features/cuda_graph_for_multi_modal_encoder\"},{\"title\":\"Breakable CUDA Graph\",\"metatags\":{\"description\":\"Use Breakable CUDA Graph to insert targeted eager graph breaks for debugging and CUDA graph compatibility.\"},\"description\":null,\"href\":\"/docs/advanced_features/breakable_cuda_graph\"},{\"title\":\"Piecewise CUDA Graph\",\"metatags\":{\"description\":\"Use Piecewise CUDA Graph to reduce prefill and extend kernel launch overhead while supporting dynamic token shapes.\"},\"description\":null,\"href\":\"/docs/advanced_features/piecewise_cuda_graph\"},{\"title\":\"SGLang Model Gateway\",\"metatags\":{\"description\":\"SGLang Model Gateway: load balancing, PD disaggregation, multi-model routing, gRPC support, MCP integration, Kubernetes service discovery.\"},\"description\":null,\"href\":\"/docs/advanced_features/sgl_model_gateway\"},{\"title\":\"Deterministic Inference\",\"metatags\":{\"description\":\"SGLang deterministic inference: consistent outputs for RL training, testing, and production. Supports FlashInfer, FA3, Triton backends with CUDA Graph.\"},\"description\":null,\"href\":\"/docs/advanced_features/deterministic_inference\"},{\"title\":\"Observability\",\"metatags\":{\"description\":\"SGLang observability: Prometheus metrics, request logging, request dump and replay, crash dump debugging.\"},\"description\":null,\"href\":\"/docs/advanced_features/observability\"},{\"title\":\"Checkpoint Engine Integration\",\"metatags\":{\"description\":\"SGLang checkpoint engine: distributed model weight loading, parallel multi-node setup, broadcast and P2P modes. Reduces loading time for large models.\"},\"description\":null,\"href\":\"/docs/advanced_features/checkpoint_engine\"},{\"title\":\"SGLang for RL Systems\",\"metatags\":{\"description\":\"SGLang for RL: engine sleep/wake, weight refit, partial rollout, deterministic inference, cache-aware load balancing for RLHF.\"},\"description\":null,\"href\":\"/docs/advanced_features/sglang_for_rl\"}]},{\"group\":\"Supported Models\",\"icon\":\"cubes\",\"pages\":[{\"title\":\"Supported models\",\"description\":\"See which families of SGLang-compatible models are actively maintained.\",\"mode\":\"wide\",\"href\":\"/docs/supported-models\"},{\"group\":\"Text Generation\",\"pages\":[{\"title\":\"Large Language Models\",\"description\":null,\"href\":\"/docs/supported-models/generative_models\"},{\"title\":\"Multimodal Language Models\",\"metatags\":{\"description\":\"Documentation for Multimodal Language Models\"},\"description\":null,\"href\":\"/docs/supported-models/multimodal_language_models\"},{\"title\":\"Diffusion language models\",\"description\":null,\"href\":\"/docs/supported-models/diffusion_language_models\"}]},{\"group\":\"Retrieval and Ranking\",\"pages\":[{\"title\":\"Embedding models\",\"description\":\"Dense and sparse embedding models with FlashInfer acceleration and SGLang's batching infrastructure.\",\"href\":\"/docs/supported-models/embedding_models\"},{\"title\":\"Rerank models\",\"description\":null,\"href\":\"/docs/supported-models/rerank_models\"},{\"title\":\"Classification Models\",\"description\":null,\"href\":\"/docs/supported-models/classify_models\"}]},{\"group\":\"Specialized Models\",\"pages\":[{\"title\":\"Reward models\",\"description\":null,\"href\":\"/docs/supported-models/reward_models\"}]},{\"group\":\"Extending SGLang\",\"pages\":[{\"title\":\"How to Support New Models\",\"description\":\"This document explains how to add support for new language models and multimodal large language models (MLLMs) in SGLang. It also covers how to test new models and register external implementations.\",\"href\":\"/docs/supported-models/support_new_models\"},{\"title\":\"Transformers Fallback in SGLang\",\"description\":null,\"href\":\"/docs/supported-models/transformers_fallback\"},{\"title\":\"Use Models From ModelScope\",\"description\":null,\"href\":\"/docs/supported-models/modelscope\"},{\"title\":\"MindSpore Models\",\"description\":null,\"href\":\"/docs/supported-models/mindspore_models\"}]}]},{\"group\":\"Developer Guide\",\"icon\":\"code\",\"pages\":[{\"title\":\"Developer Guide\",\"description\":\"Contributing to SGLang — development setup, benchmarking, and evaluation.\",\"href\":\"/docs/developer_guide/overview\"},{\"title\":\"Contribution Guide\",\"mode\":\"wide\",\"metatags\":{\"description\":\"SGLang contribution guide: source install, pre-commit, unit tests, CI triggers, code style, sgl-kernel updates.\"},\"description\":null,\"href\":\"/docs/developer_guide/contribution_guide\"},{\"group\":\"Development\",\"pages\":[{\"title\":\"Development Guide Using Docker\",\"sidebarTitle\":\"Using Docker\",\"metatags\":{\"description\":\"SGLang Docker development: VSCode dev container, remote tunnels, debugger setup, nsys profiling.\"},\"description\":null,\"href\":\"/docs/developer_guide/development_guide_using_docker\"},{\"title\":\"Development Guide for JIT Kernels\",\"sidebarTitle\":\"JIT Kernels\",\"metatags\":{\"description\":\"SGLang JIT kernel development: clangd setup, TensorMatcher, LaunchKernel, add_constant example walkthrough.\"},\"description\":null,\"href\":\"/docs/developer_guide/development_jit_kernel_guide\"}]},{\"group\":\"Benchmarking\",\"pages\":[{\"title\":\"Benchmark and Profiling\",\"metatags\":{\"description\":\"SGLang benchmarking and profiling: PyTorch Profiler, Nsight Systems, layerwise NVTX, PD disaggregation profiling.\"},\"description\":null,\"href\":\"/docs/developer_guide/benchmark_and_profiling\"},{\"title\":\"Bench Serving Guide\",\"metatags\":{\"description\":\"SGLang bench_serving: benchmark throughput, TTFT, ITL with random/sharegpt/image datasets. Multi-backend support.\"},\"description\":null,\"href\":\"/docs/developer_guide/bench_serving\"}]},{\"title\":\"Evaluating New Models with SGLang\",\"metatags\":{\"description\":\"SGLang model evaluation: MMLU, GSM8K, GPQA, HumanEval, MMMU benchmarks. Latency and throughput testing commands.\"},\"description\":null,\"href\":\"/docs/developer_guide/evaluating_new_models\"},{\"title\":\"MSProbe Debugging Guide\",\"metatags\":{\"description\":\"Debugging AI model accuracy anomalies and numerical errors during inference using MSProbe in SGLang.\"},\"description\":null,\"href\":\"/docs/developer_guide/msprobe_debugging_guide\"}]},{\"group\":\"References\",\"icon\":\"bookmark\",\"pages\":[{\"title\":\"References\",\"description\":\"FAQ, environment variables, production metrics, deployment guides, and more.\",\"href\":\"/docs/references/overview\"},{\"title\":\"Troubleshooting and Frequently Asked Questions\",\"metatags\":{\"description\":\"SGLang troubleshooting: CUDA OOM, illegal memory access, server hangs, non-deterministic outputs.\"},\"description\":null,\"href\":\"/docs/references/faq\"},{\"title\":\"Environment Variables\",\"metatags\":{\"description\":\"SGLang environment variables: SGLANG_* and SGL_* configs for performance, memory, DeepGEMM, DeepEP, profiling.\"},\"description\":null,\"href\":\"/docs/references/environment_variables\"},{\"title\":\"Production Metrics\",\"metatags\":{\"description\":\"SGLang Prometheus metrics: TTFT, TPOT, throughput, cache hit rate. Grafana dashboard setup guide.\"},\"description\":null,\"href\":\"/docs/references/production_metrics\"},{\"title\":\"Production Request Tracing\",\"metatags\":{\"description\":\"SGLang OpenTelemetry tracing: Jaeger visualization, trace context propagation, PD disaggregation support.\"},\"description\":null,\"href\":\"/docs/references/production_request_trace\"},{\"group\":\"Multi-Node Deployment\",\"pages\":[{\"title\":\"Multi-Node Deployment\",\"metatags\":{\"description\":\"SGLang multi-node deployment index: K8s, LWS, RBG, PD disaggregation guides.\"},\"description\":null,\"href\":\"/docs/references/multi_node_deployment/multi_node_index\"},{\"title\":\"Multi-Node Deployment\",\"metatags\":{\"description\":\"SGLang multi-node: Llama 405B on 2 nodes, DeepSeek V3/R1, SLURM cluster deployment examples.\"},\"description\":null,\"href\":\"/docs/references/multi_node_deployment/multi_node\"},{\"title\":\"Deploy On Kubernetes\",\"metatags\":{\"description\":\"SGLang on Kubernetes with LWS: DeepSeek-R1 multi-node deployment, RoCE RDMA setup, NCCL debugging.\"},\"description\":null,\"href\":\"/docs/references/multi_node_deployment/deploy_on_k8s\"},{\"title\":\"LWS Based PD Deploy\",\"metatags\":{\"description\":\"SGLang LWS PD deployment: DeepSeek R1 prefill/decode disaggregation on Kubernetes with RDMA.\"},\"description\":null,\"href\":\"/docs/references/multi_node_deployment/lws_pd/lws_pd_deploy\"},{\"title\":\"DeepSeekV32-Exp RBG Based PD Deploy\",\"metatags\":{\"description\":\"SGLang DeepSeek V3.2 RBG deployment: RoleBasedGroup PD disaggregation on Kubernetes.\"},\"description\":null,\"href\":\"/docs/references/multi_node_deployment/rbg_pd/deepseekv32_pd\"}]},{\"title\":\"Custom Chat Template\",\"metatags\":{\"description\":\"SGLang custom chat templates: JSON and Jinja formats for OpenAI-compatible API server. Override tokenizer defaults.\"},\"description\":null,\"href\":\"/docs/references/custom_chat_template\"},{\"group\":\"Frontend Language\",\"pages\":[{\"title\":\"Frontend Language\",\"metatags\":{\"description\":\"SGLang frontend language documentation: tutorials and choices methods reference.\"},\"description\":null,\"href\":\"/docs/references/frontend/frontend_index\"},{\"title\":\"SGLang Frontend Language\",\"metatags\":{\"description\":\"SGLang frontend tutorial: multi-turn dialog, fork parallelism, regex constraints, batching, streaming.\"},\"description\":null,\"href\":\"/docs/references/frontend/frontend_tutorial\"},{\"title\":\"Choices Methods in SGLang\",\"metatags\":{\"description\":\"SGLang choices methods: token_length_normalized, greedy_token_selection, unconditional_likelihood_normalized.\"},\"description\":null,\"href\":\"/docs/references/frontend/choices_methods\"}]},{\"group\":\"Cookbook\",\"pages\":[{\"title\":\"Server Arguments\",\"metatags\":{\"description\":\"SGLang server CLI arguments reference - tensor parallelism, data parallelism, expert parallelism, and configuration options.\"},\"description\":null,\"href\":\"/cookbook/base/reference/server_arguments\"}]},{\"title\":\"Post-Training Integration\",\"metatags\":{\"description\":\"SGLang post-training: RLHF integration with Miles, slime, AReaL, ROLL, verl, Unsloth, LLaMA Factory.\"},\"description\":null,\"href\":\"/docs/references/post_training_integration\"}]}]},{\"tab\":\"Hardware\",\"groups\":[{\"group\":\"Hardware Platforms\",\"icon\":\"microchip\",\"pages\":[{\"title\":\"Hardware Platforms\",\"description\":\"Platform-specific guides for running SGLang on GPUs, TPUs, NPUs, CPUs, and more.\",\"href\":\"/docs/hardware-platforms/overview\"},{\"title\":\"NVIDIA GPUs\",\"description\":null,\"href\":\"/docs/hardware-platforms/nvidia-gpus\"},{\"title\":\"AMD GPUs\",\"description\":null,\"href\":\"/docs/hardware-platforms/amd_gpu\"},{\"title\":\"Apple Silicon with Metal\",\"metatags\":{\"description\":\"Run SGLang on Apple Silicon using the Metal backend.\"},\"description\":null,\"href\":\"/docs/hardware-platforms/apple_metal\"},{\"group\":\"Ascend NPUs\",\"pages\":[{\"title\":\"Ascend NPU Quickstart\",\"metatags\":{\"description\":\"Quickstart for running SGLang on Ascend NPUs with the official container image, including server launch and test request examples.\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_quick_start\"},{\"title\":\"SGLang installation with NPUs support\",\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu\"},{\"title\":\"Support Features on Ascend NPU\",\"metatags\":{\"description\":\"Documentation for Support Features on Ascend NPU\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_support_features\"},{\"title\":\"Support Models on Ascend NPU\",\"metatags\":{\"description\":\"Documentation for Support Models on Ascend NPU\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_support_models\"},{\"title\":\"Quantization on Ascend\",\"metatags\":{\"description\":\"Load, export, and serve quantized models on Ascend NPUs with SGLang.\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_quantization\"},{\"title\":\"DeepSeek Examples\",\"metatags\":{\"description\":\"Examples for running DeepSeek models on Ascend NPUs, including PD mixed mode, PD disaggregation, and SGLang Model Gateway.\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_deepseek_example\"},{\"title\":\"Qwen3 Examples\",\"metatags\":{\"description\":\"Documentation for Qwen3 Examples\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_qwen3_examples\"},{\"title\":null,\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/mindspore_backend\"},{\"title\":\"Contribution Guide\",\"metatags\":{\"description\":\"Set up the Ascend NPU development environment, run tests, build documentation, and open SGLang pull requests.\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_contribution_guide\"},{\"title\":\"How to Support New Models\",\"description\":\"This document explains how to add support for new language models and multimodal large language models (MLLMs) in SGLang. It also covers how to test new models and register external implementations.\",\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_support_new_models\"},{\"title\":\"Best Practice on Ascend NPU\",\"metatags\":{\"description\":\"Documentation for Best Practice on Ascend NPU\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_best_practice\"},{\"title\":\"Ascend NPU Optimization\",\"metatags\":{\"description\":\"Learn how to optimize SGLang for Ascend NPU using the best practice configurations for mainstream LLM models\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_optimization\"},{\"title\":\"Ascend NPU Accuracy Evaluation\",\"metatags\":{\"description\":\"Complete guide for SGLang model accuracy evaluation on Ascend NPU using EvalScope and AISBench, covering text/multimodal scenarios.\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_accuracy_evaluation\"},{\"title\":\"Ascend NPU Performance Testing\",\"metatags\":{\"description\":\"Performance testing for SGLang on Ascend NPUs for text generation, multimodal, and embedding models in both online and offline serving modes.\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_performance_testing\"},{\"title\":\"Ascend NPU Ring-SP Performance (Wan2.1-T2V-1.3B)\",\"metatags\":{\"description\":\"This page reports Ring-SP performance on Ascend NPU with torchnpu==2.10.0.\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_ring_sp_performance\"},{\"title\":\"Qwen3.5 examples\",\"metatags\":{\"description\":\"Documentation for Qwen3.5 examples\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_qwen3_5_examples\"},{\"title\":\"GLM-5 examples\",\"metatags\":{\"description\":\"Documentation for GLM-5 examples\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_glm5_examples\"},{\"title\":\"Environment Variables\",\"metatags\":{\"description\":\"Reference commonly used Ascend NPU environment variables for configuring SGLang runtime behavior.\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_environment_variables\"},{\"title\":\"Ascend NPU Troubleshooting and FAQ\",\"metatags\":{\"description\":\"Troubleshooting and frequently asked questions for Ascend NPU\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_faq\"},{\"title\":\"Operator Performance Optimizing Guidance\",\"metatags\":{\"description\":\"Operator Performance Optimizing Guidance for NPU\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_operator_performance_optimizing\"},{\"title\":\"Ascend NPU Performance Profiling Guide\",\"metatags\":{\"description\":\"Ascend NPU performance profiling guide: use SGLang's built-in PyTorch Profiler for operator-level performance analysis of Ascend NPU inference services.\"},\"description\":null,\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_profiling\"},{\"title\":\"Ascend NPU Operator Development Guide\",\"description\":\"How to develop custom operators (Ascend C / Triton) for Ascend NPU and integrate them into the SGLang inference engine.\",\"href\":\"/docs/hardware-platforms/ascend-npus/ascend_npu_operator_development\"}]},{\"title\":\"CPU Servers\",\"description\":null,\"href\":\"/docs/hardware-platforms/cpu_server\"},{\"group\":\"Edge \u0026 Embedded\",\"pages\":[{\"title\":\"NVIDIA Jetson Orin\",\"description\":\"Guide for installing and running SGLang on NVIDIA Jetson Orin devices.\",\"href\":\"/docs/hardware-platforms/nvidia_jetson\"}]},{\"title\":\"Moore Threads GPUs\",\"metatags\":{\"description\":\"Run SGLang on Moore Threads GPUs.\"},\"description\":null,\"href\":\"/docs/hardware-platforms/mthreads_gpu\"},{\"title\":\"TPU\",\"description\":\"SGLang supports high-performance TPU inference through the SGLang-JAX backend, which is specifically optimized for Google Cloud TPUs. The JAX-based implementation delivers exceptional throughput and low latency for Large Language Model (LLM) serving workloads on TPU hardware.\",\"href\":\"/docs/hardware-platforms/tpu\"},{\"title\":\"XPU\",\"sidebarTitle\":\"Intel GPUs (XPU)\",\"description\":null,\"href\":\"/docs/hardware-platforms/xpu\"},{\"title\":\"SGLang Plugin System\",\"metatags\":{\"description\":\"Allows hardware vendors and developers to extend SGLang without modifying the main repository code.\"},\"description\":null,\"href\":\"/docs/hardware-platforms/plugin\"}]}]},{\"tab\":\"Cookbook\",\"groups\":[{\"group\":\"Cookbook\",\"icon\":\"book\",\"pages\":[{\"title\":\"SGLang Cookbook\",\"metatags\":{\"description\":\"The SGLang Cookbook is a practical collection of examples and guides that show developers how to efficiently run SGLang with a variety of models on different platforms.\"},\"description\":null,\"href\":\"/cookbook/intro\"},{\"group\":\"Autoregressive Models\",\"pages\":[{\"title\":\"Overview\",\"mode\":\"wide\",\"description\":\"Practical guides for deploying and using large language models and vision language models with SGLang.\",\"metatags\":{\"description\":\"Explore SGLang autoregressive model cookbooks for LLM and VLM deployment, invocation, optimization, and benchmarking examples.\"},\"href\":\"/cookbook/autoregressive/intro\"},{\"group\":\"Qwen\",\"pages\":[{\"title\":\"Qwen3.6\",\"metatags\":{\"description\":\"Deploy Qwen3.6 with SGLang - open-weight multimodal series with a 35B MoE (3B active) variant and a 27B dense variant, hybrid reasoning, tool calling, MTP, and long-context support.\"},\"tag\":\"NEW\",\"description\":null,\"href\":\"/cookbook/autoregressive/Qwen/Qwen3.6\"},{\"title\":\"Qwen3.5\",\"metatags\":{\"description\":\"Deploy Qwen3.5 with SGLang - flagship Qwen model with unified vision-language foundation, hybrid architecture, and scalable reasoning.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Qwen/Qwen3.5\"},{\"title\":\"Qwen3\",\"metatags\":{\"description\":\"Deploy Qwen3 series models with SGLang - featuring advanced reasoning, 256K context, and flexible Dense/MoE architectures for edge to cloud.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Qwen/Qwen3\"},{\"title\":\"Qwen3-Next\",\"metatags\":{\"description\":\"Deploy Qwen3-Next with SGLang - hybrid attention architecture supporting 262K context, 80B MoE with 3B active parameters, and multi-token prediction.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Qwen/Qwen3-Next\"},{\"title\":\"Qwen3-Coder\",\"metatags\":{\"description\":\"Deploy Qwen3-Coder(480B, 30B) MoE coding model with SGLang on AMD MI300X (MI325X, MI355X)\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Qwen/Qwen3-Coder\"},{\"title\":\"Qwen3-Coder-Next\",\"metatags\":{\"description\":\"Deploy Qwen3-Coder-Next code-focused models with SGLang on AMD MI300X - available in 3B to 80B sizes with enhanced code understanding.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Qwen/Qwen3-Coder-Next\"},{\"title\":\"Qwen3-VL\",\"metatags\":{\"description\":\"Deploy Qwen3-VL vision-language models with SGLang - open model for text, 262K context, enhanced visual reasoning and agent capabilities.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Qwen/Qwen3-VL\"},{\"title\":\"Qwen2.5-VL\",\"metatags\":{\"description\":\"Deploy Qwen2.5-VL vision-language models with SGLang on AMD MI300X - available in 3B to 72B sizes with enhanced visual understanding.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Qwen/Qwen2.5-VL\"}]},{\"group\":\"DeepSeek\",\"pages\":[{\"title\":\"DeepSeek-V4\",\"metatags\":{\"description\":\"Deploy DeepSeek-V4 with SGLang — a next-generation MoE model from DeepSeek.\"},\"tag\":\"NEW\",\"description\":null,\"href\":\"/cookbook/autoregressive/DeepSeek/DeepSeek-V4\"},{\"title\":\"DeepSeek-V3.2\",\"metatags\":{\"description\":\"Deploy DeepSeek-V3.2 with SGLang - featuring DeepSeek Sparse Attention for efficient long-context processing and deep reasoning capabilities.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/DeepSeek/DeepSeek-V3_2\"},{\"title\":\"DeepSeek-V3.1\",\"metatags\":{\"description\":\"Deploy DeepSeek-V3.1 MoE model with SGLang - hybrid reasoning, improved tool calling, and agentic behavior for complex multi-step tasks.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/DeepSeek/DeepSeek-V3_1\"},{\"title\":\"DeepSeek-V3\",\"metatags\":{\"description\":\"Deploy DeepSeek-V3 MoE model with SGLang - efficient architecture with strong reasoning, coding, and tool-augmented capabilities.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/DeepSeek/DeepSeek-V3\"},{\"title\":\"DeepSeek-R1\",\"metatags\":{\"description\":\"Deploy DeepSeek-R1 reasoning model with SGLang - advanced step-by-step reasoning with FP8/FP4 quantization for NVIDIA and AMD GPUs.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/DeepSeek/DeepSeek-R1\"},{\"title\":\"DeepSeek-Math-V2\",\"metatags\":{\"description\":\"Deploy DeepSeek-Math-V2 with SGLang - advanced mathematical reasoning model with gold-level IMO/CMO performance and theorem-proving capabilities.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/DeepSeek/DeepSeek-Math-V2\"},{\"title\":\"DeepSeek-OCR\",\"metatags\":{\"description\":\"Deploy DeepSeek-OCR with SGLang - high-accuracy text extraction from images and documents for OCR tasks.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/DeepSeek/DeepSeek-OCR\"},{\"title\":\"DeepSeek-OCR-2\",\"metatags\":{\"description\":\"Deploy DeepSeek-OCR-2 with SGLang - high-accuracy text extraction from images and documents for OCR tasks.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/DeepSeek/DeepSeek-OCR-2\"}]},{\"group\":\"Llama\",\"pages\":[{\"title\":\"Llama 4\",\"metatags\":{\"description\":\"Deploy Llama 4 Scout and Maverick with SGLang - Meta's latest generation open-source LLMs with industry-leading performance.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Llama/Llama4\"},{\"title\":\"Llama-3.3-70B\",\"metatags\":{\"description\":\"Deploy Llama-3.3-70B-Instruct with SGLang on AMD GPUs - 128K context, enhanced reasoning, tool calling, and multilingual support.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Llama/Llama3.3-70B\"},{\"title\":\"Llama-3.1\",\"metatags\":{\"description\":\"Deploy Llama 3.1 (8B/70B/405B) with SGLang - 128K context, tool use, multilingual support, and speculative decoding optimization.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Llama/Llama3.1\"}]},{\"group\":\"GLM\",\"pages\":[{\"title\":\"GLM-5.1\",\"metatags\":{\"description\":\"Deploy GLM-5.1 with SGLang on NVIDIA H100/H200/B200/GB300 and AMD MI300X/MI325X/MI355X.\"},\"tag\":\"NEW\",\"description\":null,\"href\":\"/cookbook/autoregressive/GLM/GLM-5.1\"},{\"title\":\"GLM-5\",\"metatags\":{\"description\":\"Deploy GLM-5 with SGLang on NVIDIA H100/H200/B200 and AMD MI300X/MI325X/MI355X — state-of-the-art reasoning, enhanced coding, and robust tool calling capabilities.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/GLM/GLM-5\"},{\"title\":\"GLM-OCR\",\"metatags\":{\"description\":\"Deploy GLM-OCR with SGLang - state-of-the-art OCR performance for complex document understanding.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/GLM/GLM-OCR\"},{\"title\":\"GLM Glyph\",\"metatags\":{\"description\":\"Deploy GLM-Glyph with SGLang - community contribution guide for Zhipu AI's GLM Glyph model deployment.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/GLM/GLM-Glyph\"},{\"title\":\"GLM-4.7\",\"metatags\":{\"description\":\"Deploy GLM-4.7 with SGLang on NVIDIA Blackwell (B200, GB200) and AMD GPUs - state-of-the-art reasoning, robust tool calling, and NVFP4 weights for Blackwell.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/GLM/GLM-4.7\"},{\"title\":\"GLM-4.7-Flash\",\"metatags\":{\"description\":\"Deploy GLM-4.7-Flash 30B-A3B MoE model with SGLang - lightweight, efficient inference optimized for single-GPU deployment.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/GLM/GLM-4.7-Flash\"},{\"title\":\"GLM-4.6\",\"metatags\":{\"description\":\"Deploy GLM-4.6 with SGLang - 200K context window, superior coding, advanced reasoning, and enhanced agentic capabilities.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/GLM/GLM-4.6\"},{\"title\":\"GLM-4.6V\",\"metatags\":{\"description\":\"Deploy GLM-4.6V vision-language model with SGLang - native function calling, 128K context, multimodal document understanding and frontend replication.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/GLM/GLM-4.6V\"},{\"title\":\"GLM-4.5\",\"metatags\":{\"description\":\"Deploy GLM-4.5 with SGLang on AMD GPUs - advanced reasoning, function calling, BF16/FP8 quantization options.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/GLM/GLM-4.5\"},{\"title\":\"GLM-4.5V\",\"metatags\":{\"description\":\"Deploy GLM-4.5V vision-language model with SGLang - SOTA multimodal performance, 64K context, image reasoning and video understanding.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/GLM/GLM-4.5V\"}]},{\"group\":\"Google\",\"pages\":[{\"title\":\"Gemma 4\",\"metatags\":{\"description\":\"Deploy Gemma 4 with SGLang - Google's next-generation open models with MoE variants and multimodal support for text, vision, and audio.\"},\"tag\":\"NEW\",\"description\":null,\"href\":\"/cookbook/autoregressive/Google/Gemma4\"}]},{\"group\":\"OpenAI\",\"pages\":[{\"title\":\"GPT-OSS\",\"metatags\":{\"description\":\"Deploy GPT-OSS (20B/120B) with SGLang - configurable reasoning, full chain-of-thought, MXFP4 quantization for single GPU deployment.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/OpenAI/GPT-OSS\"}]},{\"group\":\"Moonshotai\",\"pages\":[{\"title\":\"Kimi-K2.6\",\"metatags\":{\"description\":\"Deploy Kimi-K2.6 native multimodal agentic model with SGLang - reasoning, tool calling, and multimodal capabilities.\"},\"tag\":\"NEW\",\"description\":null,\"href\":\"/cookbook/autoregressive/Moonshotai/Kimi-K2.6\"},{\"title\":\"Kimi-K2.5\",\"metatags\":{\"description\":\"Deploy Kimi-K2.5 MoE model with SGLang - 1T total parameters, 32B active, step-by-step reasoning and tool calling capabilities.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Moonshotai/Kimi-K2.5\"},{\"title\":\"Kimi-K2\",\"metatags\":{\"description\":\"Deploy Kimi-K2 MoE model with SGLang - 1T total parameters, 32B active, step-by-step reasoning and tool calling capabilities.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Moonshotai/Kimi-K2\"},{\"title\":\"Kimi-Linear\",\"metatags\":{\"description\":\"Deploy Kimi-Linear with SGLang - community contribution guide for Moonshot AI's Kimi-Linear model deployment.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Moonshotai/Kimi-Linear\"}]},{\"group\":\"MiniMax\",\"pages\":[{\"title\":\"MiniMax-M2.7\",\"metatags\":{\"description\":\"Deploy MiniMax-M2.7 with SGLang on NVIDIA and AMD GPUs — model self-evolution, professional software engineering, and native agent teams.\"},\"tag\":\"NEW\",\"description\":null,\"href\":\"/cookbook/autoregressive/MiniMax/MiniMax-M2.7\"},{\"title\":\"MiniMax-M2\",\"metatags\":{\"description\":\"Deploy MiniMax-M2 with SGLang - community contribution guide for MiniMax M2 model deployment.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/MiniMax/MiniMax-M2\"},{\"title\":\"MiniMax-M2.5\",\"metatags\":{\"description\":\"Deploy MiniMax-M2.5 with SGLang - community contribution guide for MiniMax M2.5 model deployment.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/MiniMax/MiniMax-M2.5\"}]},{\"group\":\"NVIDIA\",\"pages\":[{\"title\":\"Nemotron 3 Nano Omni\",\"metatags\":{\"description\":\"Deploy NVIDIA Nemotron 3 Nano Omni multimodal MoE model with SGLang - text, image, video, and audio inputs with reasoning and tool calling.\"},\"tag\":\"NEW\",\"description\":null,\"href\":\"/cookbook/autoregressive/NVIDIA/Nemotron3-Nano-Omni\"},{\"title\":\"Nemotron3-Nano\",\"metatags\":{\"description\":\"Deploy NVIDIA Nemotron3-Nano 30B hybrid LLM with SGLang - MoE, Mamba2, and attention layers with BF16/FP8 precision options.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/NVIDIA/Nemotron3-Nano\"},{\"title\":\"NVIDIA Nemotron3-Super\",\"metatags\":{\"description\":\"Deploy NVIDIA Nemotron3-Super with SGLang - 120B hybrid MoE model (12B active) with 1M context window optimized for multi-agent systems and tool use.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/NVIDIA/Nemotron3-Super\"}]},{\"group\":\"Ernie\",\"pages\":[{\"title\":\"Ernie4.5\",\"metatags\":{\"description\":\"Deploy Ernie4.5 with SGLang - community contribution guide for Baidu's Ernie 4.5 model deployment.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Ernie/Ernie4.5\"},{\"title\":\"Ernie4.5-VL\",\"metatags\":{\"description\":\"Deploy Ernie4.5-VL vision-language model with SGLang - community contribution guide for Baidu's multimodal model.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/Ernie/Ernie4.5-VL\"}]},{\"group\":\"StepFun\",\"pages\":[{\"title\":\"Step-3.7-Flash (new)\",\"metatags\":{\"description\":\"Deploy Step-3.7-Flash multimodal reasoning engine with SGLang.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/StepFun/Step-3.7-Flash\"},{\"title\":\"Step-3.5-Flash\",\"metatags\":{\"description\":\"Deploy Step-3.5 reasoning engine with SGLang. \"},\"description\":null,\"href\":\"/cookbook/autoregressive/StepFun/Step3.5\"},{\"title\":\"Step3-VL-10B\",\"metatags\":{\"description\":\"Deploy Step3-VL-10B multimodal model with SGLang - compact 10B dense model with frontier-level vision understanding, complex reasoning, and tool calling capabilities.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/StepFun/Step3-VL-10B\"}]},{\"group\":\"InclusionAI\",\"pages\":[{\"title\":\"Ring-2.6-1T\",\"metatags\":{\"description\":\"Deploy Ring-2.6-1T with SGLang - a trillion-parameter InclusionAI reasoning model for agent workflows, high/xhigh reasoning effort, and tool use.\"},\"tag\":\"NEW\",\"description\":null,\"href\":\"/cookbook/autoregressive/InclusionAI/Ring-2.6-1T\"},{\"title\":\"Ling-2.6\",\"metatags\":{\"description\":\"Deploy the Ling-2.6 family with SGLang - Ling-2.6-flash (104B total / 7.4B active BF16 MoE) and Ling-2.6-1T (~1T FP8 MoE) with hybrid linear attention and agentic tool calling.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/InclusionAI/Ling-2.6\"},{\"title\":\"Ling-2.5-1T\",\"metatags\":{\"description\":\"Deploy Ling-2.5-1T with SGLang - 1T parameter MoE model with 63B active parameters, trillion-scale context length up to 1M tokens, and agentic tool calling capabilities.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/InclusionAI/Ling-2.5-1T\"},{\"title\":\"Ring-2.5-1T\",\"metatags\":{\"description\":\"Deploy Ring-2.5-1T with SGLang - world's first open-source 1T parameter reasoning model with hybrid linear attention, deep reasoning, and agentic tool calling capabilities.\"},\"description\":null,\"href\":\"/cookbook/autoregressive/InclusionAI/Ring-2.5-1T\"},{\"title\":\"LLaDA 2.1\",\"metatags\":{\"description\":\"Deploy LLaDA 2.1 with SGLang - large-scale discrete diffusion language