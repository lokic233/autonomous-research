> </a> <label class="md-nav__link " for=__nav_5_2_51_19_26_24 id=__nav_5_2_51_19_26_24_label tabindex=0> <span class="md-nav__icon md-icon"></span> </label> </div> <nav class=md-nav data-md-level=6 aria-labelledby=__nav_5_2_51_19_26_24_label aria-expanded=false> <label class=md-nav__title for=__nav_5_2_51_19_26_24> <span class="md-nav__icon md-icon"></span> spec_decode </label> <ul class=md-nav__list data-md-scrollfix> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/spec_decode/rejection_sampler/ class=md-nav__link> <span class=md-ellipsis> rejection_sampler </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils/ class=md-nav__link> <span class=md-ellipsis> rejection_sampler_utils </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/spec_decode/utils/ class=md-nav__link> <span class=md-ellipsis> utils </span> </a> </li> <li class="md-nav__item md-nav__item--nested"> <input class="md-nav__toggle md-toggle " type=checkbox id=__nav_5_2_51_19_26_24_5> <div class="md-nav__link md-nav__container"> <a href=../../api/vllm/v1/worker/gpu/spec_decode/eagle/ class="md-nav__link "> <span class=md-ellipsis> eagle </span> </a> <label class="md-nav__link " for=__nav_5_2_51_19_26_24_5 id=__nav_5_2_51_19_26_24_5_label tabindex=0> <span class="md-nav__icon md-icon"></span> </label> </div> <nav class=md-nav data-md-level=7 aria-labelledby=__nav_5_2_51_19_26_24_5_label aria-expanded=false> <label class=md-nav__title for=__nav_5_2_51_19_26_24_5> <span class="md-nav__icon md-icon"></span> eagle </label> <ul class=md-nav__list data-md-scrollfix> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/spec_decode/eagle/cudagraph/ class=md-nav__link> <span class=md-ellipsis> cudagraph </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/spec_decode/eagle/eagle3_utils/ class=md-nav__link> <span class=md-ellipsis> eagle3_utils </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/spec_decode/eagle/speculator/ class=md-nav__link> <span class=md-ellipsis> speculator </span> </a> </li> <li class=md-nav__item> <a href=../../api/vllm/v1/worker/gpu/spec_decode/eagle/utils/ class=md-nav__link> <span class=md-ellipsis> utils </span> </a> </li> </ul> </nav> </li> </ul> </nav> </li> </ul> </nav> </li> </ul> </nav> </li> </ul> </nav> </li> </ul> </nav> </li> </ul> </nav> </li> <li class="md-nav__item md-nav__item--nested"> <input class="md-nav__toggle md-toggle " type=checkbox id=__nav_6> <div class="md-nav__link md-nav__container"> <a href=../../cli/ class="md-nav__link "> <span class=md-ellipsis> CLI Reference </span> </a> <label class="md-nav__link " for=__nav_6 id=__nav_6_label tabindex=0> <span class="md-nav__icon md-icon"></span> </label> </div> <nav class=md-nav data-md-level=1 aria-labelledby=__nav_6_label aria-expanded=false> <label class=md-nav__title for=__nav_6> <span class="md-nav__icon md-icon"></span> CLI Reference </label> <ul class=md-nav__list data-md-scrollfix> <li class=md-nav__item> <a href=../../cli/serve/ class=md-nav__link> <span class=md-ellipsis> vllm serve </span> </a> </li> <li class=md-nav__item> <a href=../../cli/chat/ class=md-nav__link> <span class=md-ellipsis> vllm chat </span> </a> </li> <li class=md-nav__item> <a href=../../cli/complete/ class=md-nav__link> <span class=md-ellipsis> vllm complete </span> </a> </li> <li class=md-nav__item> <a href=../../cli/run-batch/ class=md-nav__link> <span class=md-ellipsis> vllm run-batch </span> </a> </li> <li class="md-nav__item md-nav__item--nested"> <input class="md-nav__toggle md-toggle " type=checkbox id=__nav_6_6> <label class=md-nav__link for=__nav_6_6 id=__nav_6_6_label tabindex=0> <span class=md-ellipsis> vllm bench </span> <span class="md-nav__icon md-icon"></span> </label> <nav class=md-nav data-md-level=2 aria-labelledby=__nav_6_6_label aria-expanded=false> <label class=md-nav__title for=__nav_6_6> <span class="md-nav__icon m