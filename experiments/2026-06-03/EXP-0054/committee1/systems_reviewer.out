ROLE: systems_reviewer  VOTE: yellow
EXISTING_IMPLEMENTATIONS: [
  {system: "vLLM", url: "https://github.com/vllm-project/vllm/blob/main/vllm/config/scheduler.py", overlap: "Partial shipping overlap: scheduler policies are fcfs/priority, but chunked-prefill config explicitly allows shorter prompts to jump ahead of longer prompts via max_long_partial_prefills/long_prefill_token_threshold. This is input-length-biased scheduling, not the full claimed VLM tau* crossover mechanism."},
  {system: "vLLM request queue", url: "https://github.com/vllm-project/vllm/blob/main/vllm/v1/core/sched/request_queue.py", overlap: "Shipping queue only exposes FCFS and explicit priority; no built-in global shortest-input-token SJF found."},
  {system: "SGLang", url: "https://github.com/sgl-project/sglang/blob/main/python/sglang/srt/managers/schedule_policy.py", overlap: "Shipping policies include FCFS, LPM/DFS prefix-cache-aware scheduling, LOF by max_new_tokens, random, routing-key; no shortest-input-token SJF found. LOF is adjacent because it uses an output-length proxy rather than input length."},
  {system: "TensorRT-LLM", url: "https://nvidia.github.io/TensorRT-LLM/torch/scheduler.html", overlap: "Shipping inflight batching scheduler has capacity/microbatch stages and customization hooks; documented default example admits requests by active-request order/capacity, not input-length SJF."},
  {system: "FlashInfer / LMCache", url: "https://github.com/flashinfer-ai/flashinfer ; https://github.com/LMCache/LMCache", overlap: "Searched as requested; these are kernel/cache infrastructure, not evidence of a shipped request-level input-length SJF scheduler."}
