gba(255,255,255,0.02);\n}\n\nhtml.dark table thead th:nth-child(even),\n[data-theme=\"dark\"] table thead th:nth-child(even) {\n  background-color: rgba(255,255,255,0.05);\n}\n\nhtml.dark table tbody tr:nth-child(odd) td,\n[data-theme=\"dark\"] table tbody tr:nth-child(odd) td {\n  background-color: rgba(255,255,255,0.02);\n}\n\nhtml.dark table tbody tr:nth-child(even) td,\n[data-theme=\"dark\"] table tbody tr:nth-child(even) td {\n  background-color: rgba(255,255,255,0.05);\n}\n\n/* Bold text (**text**) */\n.prose strong, .prose b {\n  font-weight: 600;\n}\n\n/* Inline code (single backtick) */\n:not(pre) \u003e code {\n  background-color: rgba(0, 0, 0, 0.07);\n  font-weight: 600;\n}\n\nhtml.dark :not(pre) \u003e code,\n[data-theme=\"dark\"] :not(pre) \u003e code {\n  background-color: rgba(255, 255, 255, 0.13);\n  font-weight: 600;\n}\n"])</script><script>self.__next_f.push([1,"48:[\"$\",\"$L4a\",null,{\"value\":{\"apiReferenceData\":{}},\"children\":[\"$\",\"$L4b\",null,{\"value\":{\"pageMetadata\":\"$1c:props:pageMetadata\",\"lastModified\":\"2026-06-03T08:43:48.079Z\",\"originalFileLocation\":\"docs/advanced_features/server_arguments.mdx\",\"description\":null,\"mdxExtracts\":{\"tableOfContents\":[{\"title\":\"Common launch commands\",\"slug\":\"common-launch-commands\",\"depth\":2,\"children\":[]},{\"title\":\"Model and tokenizer\",\"slug\":\"model-and-tokenizer\",\"depth\":2,\"children\":[]},{\"title\":\"HTTP server\",\"slug\":\"http-server\",\"depth\":2,\"children\":[]},{\"title\":\"Quantization and data type\",\"slug\":\"quantization-and-data-type\",\"depth\":2,\"children\":[]},{\"title\":\"Memory and scheduling\",\"slug\":\"memory-and-scheduling\",\"depth\":2,\"children\":[]},{\"title\":\"Runtime options\",\"slug\":\"runtime-options\",\"depth\":2,\"children\":[]},{\"title\":\"Logging\",\"slug\":\"logging\",\"depth\":2,\"children\":[]},{\"title\":\"RequestMetricsExporter configuration\",\"slug\":\"requestmetricsexporter-configuration\",\"depth\":2,\"childre