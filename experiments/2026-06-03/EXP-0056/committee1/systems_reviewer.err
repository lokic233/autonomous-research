332:def _shuffle(data, bufsize=1000, initial=100, rng=None, seed=None, handler=None):
333-    """
334-    Shuffle the data in the stream.
335-
336-    This uses a buffer of size `bufsize`. Shuffling at
337-    startup is less random; this is traded off against
338-    yielding samples quickly.
339-
340-    Args:
341-        data: Iterator to shuffle.
342-        bufsize (int): Buffer size for shuffling.
343-        initial (int): Initial buffer size before yielding.
344-        rng: Random number generator.
345-        seed: Seed for the random number generator.
346-        handler: Exception handler.
347-
348-    Yields:
349-        Shuffled items from the input iterator.
350-    """
351-    if seed is not None:
352-        assert rng is None
353-        rng = random.Random(seed)
354-    elif rng is None:
355-        rng = random.Random(int((os.getpid() + time.time()) * 1e9))
356-    initial = min(initial, bufsize)
357-    buf = []
358-    for sample in data:
359-        buf.append(sample)
360-        if len(buf) < bufsize:
361-            try:
362-                buf.append(next(data))  # skipcq: PYL-R1708
363-            except StopIteration:
364-                pass
365-        if len(buf) >= initial:
366-            yield pick(buf, rng)
367-    while len(buf) > 0:
368-        yield pick(buf, rng)
