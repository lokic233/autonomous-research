387-    def __init__(self, bufsize=1000, initial=100, seed=0, epoch=-1):
388-        """
389-        Initialize the detshuffle stage.
390-
391-        Args:
392-            bufsize (int): Size of the buffer for shuffling.
393-            initial (int): Initial number of samples to collect before shuffling.
394-            seed (int): Seed for the random number generator.
395-            epoch (int): Starting epoch number.
396-        """
397-        self.bufsize = bufsize
398-        self.initial = initial
399-        self.seed = seed
400-        self.epoch = epoch
