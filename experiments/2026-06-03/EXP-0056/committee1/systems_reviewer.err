2.p1.8.m8.1a"><msub id="S2.SS2.p1.8.m8.1.1" xref="S2.SS2.p1.8.m8.1.1.cmml"><mi id="S2.SS2.p1.8.m8.1.1.2" xref="S2.SS2.p1.8.m8.1.1.2.cmml">Y</mi><mi id="S2.SS2.p1.8.m8.1.1.3" xref="S2.SS2.p1.8.m8.1.1.3.cmml">i</mi></msub><annotation-xml encoding="MathML-Content" id="S2.SS2.p1.8.m8.1b"><apply id="S2.SS2.p1.8.m8.1.1.cmml" xref="S2.SS2.p1.8.m8.1.1"><csymbol cd="ambiguous" id="S2.SS2.p1.8.m8.1.1.1.cmml" xref="S2.SS2.p1.8.m8.1.1">subscript</csymbol><ci id="S2.SS2.p1.8.m8.1.1.2.cmml" xref="S2.SS2.p1.8.m8.1.1.2">𝑌</ci><ci id="S2.SS2.p1.8.m8.1.1.3.cmml" xref="S2.SS2.p1.8.m8.1.1.3">𝑖</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS2.p1.8.m8.1c">Y_{i}</annotation><annotation encoding="application/x-llamapun" id="S2.SS2.p1.8.m8.1d">italic_Y start_POSTSUBSCRIPT italic_i end_POSTSUBSCRIPT</annotation></semantics></math> and <math alttext="X_{i}" class="ltx_Math" display="inline" id="S2.SS2.p1.9.m9.1"><semantics id="S2.SS2.p1.9.m9.1a"><msub id="S2.SS2.p1.9.m9.1.1" xref="S2.SS2.p1.9.m9.1.1.cmml"><mi id="S2.SS2.p1.9.m9.1.1.2" xref="S2.SS2.p1.9.m9.1.1.2.cmml">X</mi><mi id="S2.SS2.p1.9.m9.1.1.3" xref="S2.SS2.p1.9.m9.1.1.3.cmml">i</mi></msub><annotation-xml encoding="MathML-Content" id="S2.SS2.p1.9.m9.1b"><apply id="S2.SS2.p1.9.m9.1.1.cmml" xref="S2.SS2.p1.9.m9.1.1"><csymbol cd="ambiguous" id="S2.SS2.p1.9.m9.1.1.1.cmml" xref="S2.SS2.p1.9.m9.1.1">subscript</csymbol><ci id="S2.SS2.p1.9.m9.1.1.2.cmml" xref="S2.SS2.p1.9.m9.1.1.2">𝑋</ci><ci id="S2.SS2.p1.9.m9.1.1.3.cmml" xref="S2.SS2.p1.9.m9.1.1.3">𝑖</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS2.p1.9.m9.1c">X_{i}</annotation><annotation encoding="application/x-llamapun" id="S2.SS2.p1.9.m9.1d">italic_X start_POSTSUBSCRIPT italic_i end_POSTSUBSCRIPT</annotation></semantics></math>, a statistical model (e.g., a generalized linear model) is often assumed, which leads to a loss function evaluated at each sample <math alttext="i" class="ltx_Math" display="inline" id="S2.SS2.p1.10.m10.1"><semantics id="S2.SS2.p1.10.m10.1a"><mi id="S2.SS2.p1.10.m10.1.1" xref="S2.SS2.p1.10.m10.1.1.cmml">i</mi><annotation-xml encoding="MathML-Content" id="S2.SS2.p1.10.m10.1b"><ci id="S2.SS2.p1.10.m10.1.1.cmml" xref="S2.SS2.p1.10.m10.1.1">𝑖</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.SS2.p1.10.m10.1c">i</annotation><annotation encoding="application/x-llamapun" id="S2.SS2.p1.10.m10.1d">italic_i</annotation></semantics></math> as <math alttext="\ell(X_{i},Y_{i};\theta)" class="ltx_Math" display="inline" id="S2.SS2.p1.11.m11.3"><semantics id="S2.SS2.p1.11.m11.3a"><mrow id="S2.SS2.p1.11.m11.3.3" xref="S2.SS2.p1.11.m11.3.3.cmml"><mi id="S2.SS2.p1.11.m11.3.3.4" mathvariant="normal" xref="S2.SS2.p1.11.m11.3.3.4.cmml">ℓ</mi><mo id="S2.SS2.p1.11.m11.3.3.3" xref="S2.SS2.p1.11.m11.3.3.3.cmml">⁢</mo><mrow id="S2.SS2.p1.11.m11.3.3.2.2" xref="S2.SS2.p1.11.m11.3.3.2.3.cmml"><mo id="S2.SS2.p1.11.m11.3.3.2.2.3" stretchy="false" xref="S2.SS2.p1.11.m11.3.3.2.3.cmml">(</mo><msub id="S2.SS2.p1.11.m11.2.2.1.1.1" xref="S2.SS2.p1.11.m11.2.2.1.1.1.cmml"><mi id="S2.SS2.p1.11.m11.2.2.1.1.1.2" xref="S2.SS2.p1.11.m11.2.2.1.1.1.2.cmml">X</mi><mi id="S2.SS2.p1.11.m11.2.2.1.1.1.3" xref="S2.SS2.p1.11.m11.2.2.1.1.1.3.cmml">i</mi></msub><mo id="S2.SS2.p1.11.m11.3.3.2.2.4" xref="S2.SS2.p1.11.m11.3.3.2.3.cmml">,</mo><msub id="S2.SS2.p1.11.m11.3.3.2.2.2" xref="S2.SS2.p1.11.m11.3.3.2.2.2.cmml"><mi id="S2.SS2.p1.11.m11.3.3.2.2.2.2" xref="S2.SS2.p1.11.m11.3.3.2.2.2.2.cmml">Y</mi><mi id="S2.SS2.p1.11.m11.3.3.2.2.2.3" xref="S2.SS2.p1.11.m11.3.3.2.2.2.3.cmml">i</mi></msub><mo id="S2.SS2.p1.11.m11.3.3.2.2.5" xref="S2.SS2.p1.11.m11.3.3.2.3.cmml">;</mo><mi id="S2.SS2.p1.11.m11.1.1" xref="S2.SS2.p1.11.m11.1.1.cmml">θ</mi><mo id="S2.SS2.p1.11.m11.3.3.2.2.6" stretchy="false" xref="S2.SS2.p1.11.m11.3.3.2.3.cmml">)</mo></mrow></mrow><annotation-xml encoding="MathML-Content" id="S2.SS2.p1.11.m11.3b"><apply id="S2.SS2.p1.11.m11.3.3.cmml" xref="S2.SS2.p1.11.m11.3.3"><times id="S2.SS2.p1.11.m11.3.3.3.cmml" xref="S2.SS2.p1.11.m11.3.3.3"></times><ci id="S2.SS2.p1.11.m11.3.3.4.cmml" xref="S2.SS2.p1.11.m11.3.3.4">ℓ</ci><vector id="S2.SS2.p1.11.m11.3.3.2.3.cmml" xref="S2.SS2.p1.11.m11.3.3.2.2"><apply id="S2.SS2.p1.11.m11.2.2.1.1.1.cmml" xref="S2.SS2.p1.11.m11.2.2.1.1.1"><csymbol cd="ambiguous" id="S2.SS2.p1.11.m11.2.2.1.1.1.1.cmml" xref="S2.SS2.p1.11.m11.2.2.1.1.1">subscript</csymbol><ci id="S2.SS2.p1.11.m11.2.2.1.1.1.2.cmml" xref="S2.SS2.p1.11.m11.2.2.1.1.1.2">𝑋</ci><ci id="S2.SS2.p1.11.m11.2.2.1.1.1.3.cmml" xref="S2.SS2.p1.11.m11.2.2.1.1.1.3">𝑖</ci></apply><apply id="S2.SS2.p1.11.m11.3.3.2.2.2.cmml" xref="S2.SS2.p1.11.m11.3.3.2.2.2"><csymbol cd="ambiguous" id="S2.SS2.p1.11.m11.3.3.2.2.2.1.cmml" xref="S2.SS2.p1.11.m11.3.3.2.2.2">subscript</csymbol><ci id="S2.SS2.p1.11.m11.3.3.2.2.2.2.cmml" xref="S2.SS2.p1.11.m11.3.3.2.2.2.2">𝑌</ci><ci id="S2.SS2.p1.11.m11.3.3.2.2.2.3.cmml" xref="S2.SS2.p1.11.m11.3.3.2.2.2.3">𝑖</ci></apply><ci id="S2.SS2.p1.11.m11.1.1.cmml" xref="S2.SS2.p1.11.m11.1.1">𝜃</ci></vector></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS2.p1.11.m11.3c">\ell(X_{i},Y_{i};\theta)</annotation><annotation encoding="application/x-llamapun" id="S2.SS2.p1.11.m11.3d">roman_ℓ ( italic_X start_POSTSUBSCRIPT italic_i end_POSTSUBSCRIPT , italic_Y start_POSTSUBSCRIPT italic_i end_POSTSUBSCRIPT ; italic_θ )</annotation></semantics></math>, where <math alttext="\theta\in\mathbb{R}^{q}" class="ltx_Math" display="inline" id="S2.SS2.p1.12.m12.1"><semantics id="S2.SS2.p1.12.m12.1a"><mrow id="S2.SS2.p1.12.m12.1.1" xref="S2.SS2.p1.12.m12.1.1.cmml"><mi id="S2.SS2.p1.12.m12.1.1.2" xref="S2.SS2.p1.12.m12.1.1.2.cmml">θ</mi><mo id="S2.SS2.p1.12.m12.1.1.1" xref="S2.SS2.p1.12.m12.1.1.1.cmml">∈</mo><msup id="S2.SS2.p1.12.m12.1.1.3" xref="S2.SS2.p1.12.m12.1.1.3.cmml"><mi id="S2.SS2.p1.12.m12.1.1.3.2" xref="S2.SS2.p1.12.m12.1.1.3.2.cmml">ℝ</mi><mi id="S2.SS2.p1.12.m12.1.1.3.3" xref="S2.SS2.p1.12.m12.1.1.3.3.cmml">q</mi></msup></mrow><annotation-xml encoding="MathML-Content" id="S2.SS2.p1.12.m12.1b"><apply id="S2.SS2.p1.12.m12.1.1.cmml" xref="S2.SS2.p1.12.m12.1.1"><in id="S2.SS2.p1.12.m12.1.1.1.cmml" xref="S2.SS2.p1.12.m12.1.1.1"></in><ci id="S2.SS2.p1.12.m12.1.1.2.cmml" xref="S2.SS2.p1.12.m12.1.1.2">𝜃</ci><apply id="S2.SS2.p1.12.m12.1.1.3.cmml" xref="S2.SS2.p1.12.m12.1.1.3"><csymbol cd="ambiguous" id="S2.SS2.p1.12.m12.1.1.3.1.cmml" xref="S2.SS2.p1.12.m12.1.1.3">superscript</csymbol><ci id="S2.SS2.p1.12.m12.1.1.3.2.cmml" xref="S2.SS2.p1.12.m12.1.1.3.2">ℝ</ci><ci id="S2.SS2.p1.12.m12.1.1.3.3.cmml" xref="S2.SS2.p1.12.m12.1.1.3.3">𝑞</ci></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS2.p1.12.m12.1c">\theta\in\mathbb{R}^{q}</annotation><annotation encoding="application/x-llamapun" id="S2.SS2.p1.12.m12.1d">italic_θ ∈ blackboard_R start_POSTSUPERSCRIPT italic_q end_POSTSUPERSCRIPT</annotation></semantics></math> denotes the model parameter of interest and <math alttext="\theta^{*}" class="ltx_Math" display="inline" id="S2.SS2.p1.13.m13.1"><semantics id="S2.SS2.p1.13.m13.1a"><msup id="S2.SS2.p1.13.m13.1.1" xref="S2.SS2.p1.13.m13.1.1.cmml"><mi id="S2.SS2.p1.13.m13.1.1.2" xref="S2.SS2.p1.13.m13.1.1.2.cmml">θ</mi><mo id="S2.SS2.p1.13.m13.1.1.3" xref="S2.SS2.p1.13.m13.1.1.3.cmml">*</mo></msup><annotation-xml encoding="MathML-Content" id="S2.SS2.p1.13.m13.1b"><apply id="S2.SS2.p1.13.m13.1.1.cmml" xref="S2.SS2.p1.13.m13.1.1"><csymbol cd="ambiguous" id="S2.SS2.p1.13.m13.1.1.1.cmml" xref="S2.SS2.p1.13.m13.1.1">superscript</csymbol><ci id="S2.SS2.p1.13.m13.1.1.2.cmml" xref="S2.SS2.p1.13.m13.1.1.2">𝜃</ci><times id="S2.SS2.p1.13.m13.1.1.3.cmml" xref="S2.SS2.p1.13.m13.1.1.3"></times></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS2.p1.13.m13.1c">\theta^{*}</annotation><annotation encoding="application/x-llamapun" id="S2.SS2.p1.13.m13.1d">italic_θ start_POSTSUPERSCRIPT * end_POSTSUPERSCRIPT</annotation></semantics></math> denotes the true parameter. We allow parameter dimension <math alttext="q" class="ltx_Math" display="inline" id="S2.SS2.p1.14.m14.1"><semantics id="S2.SS2.p1.14.m14.1a"><mi id="S2.SS2.p1.14.m14.1.1" xref="S2.SS2.p1.14.m14.1.1.cmml">q</mi><annotation-xml encoding="MathML-Content" id="S2.SS2.p1.14.m14.1b"><ci id="S2.SS2.p1.14.m14.1.1.cmml" xref="S2.SS2.p1.14.m14.1.1">𝑞</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.SS2.p1.14.m14.1c">q</annotation><annotation encoding="application/x-llamapun" id="S2.SS2.p1.14.m14.1d">italic_q</annotation></semantics></math> and predictor dimension <math alttext="p" class="ltx_Math" display="inline" id="S2.SS2.p1.15.m15.1"><semantics id="S2.SS2.p1.15.m15.1a"><mi id="S2.SS2.p1.15.m15.1.1" xref="S2.SS2.p1.15.m15.1.1.cmml">p</mi><annotation-xml encoding="MathML-Content" id="S2.SS2.p1.15.m15.1b"><ci id="S2.SS2.p1.15.m15.1.1.cmml" xref="S2.SS2.p1.15.m15.1.1">𝑝</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.SS2.p1.15.m15.1c">p</annotation><annotation encoding="application/x-llamapun" id="S2.SS2.p1.15.m15.1d">italic_p</annotation></semantics></math> to be different. For most regression problems, we should have the coefficient <math alttext="\theta" class="ltx_Math" display="inline" id="S2.SS2.p1.16.m16.1"><semantics id="S2.SS2.p1.16.m16.1a"><mi id="S2.SS2.p1.16.m16.1.1" xref="S2.SS2.p1.16.m16.1.1.cmml">θ</mi><annotation-xml encoding="MathML-Content" id="S2.SS2.p1.16.m16.1b"><ci id="S2.SS2.p1.16.m16.1.1.cmml" xref="S2.SS2.p1.16.m16.1.1">𝜃</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.SS2.p1.16.m16.1c">\theta</annotation><annotation encoding="application/x-llamapun" id="S2.SS2.p1.16.m16.1d">italic_θ</annotation></semantics></math> sharing the same dimension as the predictor <math alttext="X" class="ltx_Math" display="inline" id="S2.SS2.p1.17.m17.1"><semantics id="S2.SS2.p1.17.m17.1a"><mi id="S2.SS2.p1.17.m17.1.1" xref="S2.SS2.p1.17.m17.1.1.cmml">X</mi><annotation-xml encoding="MathML-Content" id="S2.SS2.p1.17.m17.1b"><ci id="S2.SS2.p1.17.m17.1.1.cmml" xref="S2.SS2.p1.17.m17.1.1">𝑋</ci></annotation-xml><annotation encoding="application/x-tex" id="S2.SS2.p1.17.m17.1c">X</annotation><annotation encoding="application/x-llamapun" id="S2.SS2.p1.17.m17.1d">italic_X</annotation></semantics></math>. If this happens, we should have <math alttext="p=q" class="ltx_Math" display="inline" id="S2.SS2.p1.18.m18.1"><semantics id="S2.SS2.p1.18.m18.1a"><mrow id="S2.SS2.p1.18.m18.1.1" xref="S2.SS2.p1.18.m18.1.1.cmml"><mi id="S2.SS2.p1.18.m18.1.1.2" xref="S2.SS2.p1.18.m18.1.1.2.cmml">p</mi><mo id="S2.SS2.p1.18.m18.1.1.1" xref="S2.SS2.p1.18.m18.1.1.1.cmml">=</mo><mi id="S2.SS2.p1.18.m18.1.1.3" xref="S2.SS2.p1.18.m18.1.1.3.cmml">q</mi></mrow><annotation-xml encoding="MathML-Content" id="S2.SS2.p1.18.m18.1b"><apply id="S2.SS2.p1.18.m18.1.1.cmml" xref="S2.SS2.p1.18.m18.1.1"><eq id="S2.SS2.p1.18.m18.1.1.1.cmml" xref="S2.SS2.p1.18.m18.1.1.1"></eq><ci id="S2.SS2.p1.18.m18.1.1.2.cmml" xref="S2.SS2.p1.18.m18.1.1.2">𝑝</ci><ci id="S2.SS2.p1.18.m18.1.1.3.cmml" xref="S2.SS2.p1.18.m18.1.1.3">𝑞</ci></apply></annotation-xml><annotation encoding="application/x-tex" id="S2.SS2.p1.18.m18.1c">p=q</annotation><annotation encoding="application/x-llamapun" id="S2.SS2.p1.18.m18.1d">italic_p = italic_q</annotation></semantics></math>. Then, the global loss function is defined as <math alttext="\mathcal{L}(\theta)=N^{-1}\sum^{N}_{i=1}\ell(X_{i},Y_{i};\theta)" class="ltx_Math" display="inline" id="S2.SS2.p1.19.m19.4"><semantics id="S2.SS2.p1.19.m19.4a"><mrow id="S2.SS2.p1.19.m19.4.4" xref="S2.SS2.p1.19.m19.4.4.cmml"><mrow id="S2.SS2.p1.19.m19.4.4.4" xref="S2.SS2.p1.19.m19.4.4.4.cmml"><mi class="ltx_font_mathcaligraphic" id="S2.SS2.p1.19.m19.4.4.4.2" xref="S2.SS2.p1.19.m19.4.4.4.2.cmml">ℒ</mi><mo id="S2.SS2.p1.19.m19.4.4.4.1" xref="S2.SS2.p1.19.m19.4.4.4.1.cmml">⁢</mo><mrow id="S2.SS2.p1.19.m19.4.4.4.3.2" xref="S2.SS2.p1.19.m19.4.4.4.cmml"><mo id="S2.SS2.p1.19.m19.4.4.4.3.2.1" stretchy="false" xref="S2.SS2.p1.19.m19.4.4.4.cmml">(</mo><mi id="S2.SS2.p1.19.m19.1.1" xref="S2.SS2.p1.19.m19.1.1.cmml">θ</mi><mo id="S2.SS2.p1.19.m19.4.4.4.3.2.2" stretchy="false" xref="S2.SS2.p1.19.m19.4.4.4.cmml">)</mo></mrow></mrow><mo id="S2.SS2.p1.19.m19.4.4.3" xref="S2.SS2.p1.19.m19.4.4.3.cmml">=</mo><mrow id="S2.SS2.p1.19.m19.4.4.2" xref="S2.SS2.p1.19.m19.4.4.2.cmml"><msup id="S2.SS2.p1.19.m19.4.4.2.4" xref="S2.SS2.p1.19.m19.4.4.2.4.cmml"><mi id="S2.SS2.p1.19.m19.4.4.2.4.2" xref="S2.SS2.p1.19.m19.4.4.2.4.2.cmml">N</mi><mrow id="S2.SS2.p1.19.m19.4.4.2.4.3" xref="S2.SS2.p1.19.m19.4.4.2.4.3.cmml"><mo id="S2.SS2.p1.19.m19.4.4.2.4.3a" xref="S2.SS2.p1.19.m19.4.4.2.4.3.cmml">−</mo><mn id="S2.SS2.p1.19.m19.4.4.2.4.3.2" xref="S2.SS2.p1.19.m19.4.4.2.4.3.2.cmml">1</mn></mrow></msup><mo id="S2.SS2.p1.19.m19.4.4.2.3" xref="S2.SS2.p1.19.m19.4.4.2.3.cmml">⁢</mo><mrow id="S2.SS2.p1.19.m19.4.4.2.2" xref="S2.SS2.p1.19.m19.4.4.2.2.cmml"><msubsup id="S2.SS2.p1.19.m19.4.4.2.2.3" xref="S2.SS2.p1.19.m19.4.4.2.2.3.cmml"><mo id="S2.SS2.p1.19.m19.4.4.2.2.3.2.2" xref="S2.SS2.p1.19.m19.4.4.2.2.3.2.2.cmml">∑</mo><mrow id="S2.SS2.p1.19.m19.4.4.2.2.3.3" xref="S2.SS2.p1.19.m19.4.4.2.2.3.3.cmml"><mi id="S2.SS2.p1.19.m19.4.4.2.2.3.3.2" xref="S2.SS2.p1.19.m19.4.4.2.2.3.3.2.cmml">i</mi><mo id="S2.SS2.p1.19.m19.4.4.2.2.3.3.1" xref="S2.SS2.p1.19.m19.4.4.2.2.3.3.1.cmml">=</mo><mn id="S2.SS2.p1.19.m19.4.4.2.2.3.3.3" xref="S2.SS2.p1.19.m19.4.4.2.2.3.3.3.cmml">1</mn></mrow><mi id="S2.SS2.p1.19.m19.4.4.2.2.3.2.3" xref="S2.SS2.p1.19.m19.4.4.2.2.3.2.3.cmml">N</mi></msubsup><mrow id="S2.SS2.p1.19.m19.4.4.2.2.2" xref="S2.SS2.p1.19.m19.4.4.2.2.2.cmml"><mi id="S2.SS2.p1.19.m19.4.4.2.2.2.4" mathvariant="normal" xref="S2.SS2.p1.19.m19.4.4.2.2.2.4.cmml">ℓ</mi><mo id="S2.SS2.p1.19.m19.4.4.2.2.2.3" xref="S2.SS2.p1.19.m19.4.4.2.2.2.3.cmml">⁢</mo><mrow id="S2.SS2.p1.19.m19.4.4.2.2.2.2.2" xref="S2.SS2.p1.19.m19.4.4.2.2.2.2.3.cmml"><mo id="S2.SS2.p1.19.m19.4.4.2.2.2.2.2.3" stretchy="false" xref="S2.SS2.p1.19.m19.4.4.2.2.2.2.3.cmml">(</mo><msub id="S2.SS2.p1.19.m19.3.3.1.1.1.1.1.1" xref="S2.SS2.p1.19.m19.3.3.1.1.1.1.1.1.cmml"><mi id="S2.SS2.p1.19.m19.3.3.1.1.1.1.1.1.2" xref="S2.SS2.p1.19.m19.3.3.1.1.1.1.1.1.2.cmml">X</mi><mi id="S2.SS2.p1.19.m19.3.3.1.1.1.1.1.1.3" xref="S2.SS2.p1.19.m19.3.3.1.1.1.1.1.1.3.cmml">i</mi></msub><mo id="S2.SS2.p1.19.m19.4.4.2.2.2.2.2.4" xref="S2.SS2.p1.19.m19.4.4.2.2.2.2.3.cmml">,</mo><msub id="S2.SS2.p1.19.m19.4.4.2.2.2.2.2.2" xref="S2.SS2.p1.19.m19.4.4.2.2.2.2.2.2.cmml"><mi id="S2.SS2.p1.19.m19.4.4.2.2.2.2.2.2.2" xref="S2.SS2.p1.19.m19.4.4.2.2.2.2.2.2.2.cmml">Y</mi><mi id="S2.SS2.p1.19.m19.4.4.2.2.2.2.2.2.3" xref="S2.SS2.p1.19.m19.4.4.2.2.2.2.2.2.3.cmml">i</mi></msub><mo id="S2.SS2.p1.19.m19.4.4.2.2.2.2.2.5" xref="S2.SS2.p1.19.m19.4.4.2.2.2.2.3.cmml">;</mo><mi id="S2.SS2.p1.19.m19.2.2" xref="S2.SS2.p1.19.m19.2.2.cmml">θ</mi><mo id="S2.SS2.p1.19.m19.4.4.2.2.2.2.2.6" stretchy="false" xref="S2.SS2.p1.19.m19.4.4.2.2.2.2.3.cmml">)</mo></mrow></mrow></mrow></mrow></mrow><annotation-xml encoding="MathML-Content" id="S2.SS2.p1.19.m19.4b"><apply id="S2.SS2.p1.19.m19.4.4.cmml" xref="S2.SS2.p1.19.m19.4.4"><eq id="S2.SS2.p1.19.m19.4.4.3.cmml" xref="S2.SS2.p1.19.m19.4.4.3"></eq><apply id="S2.SS2.p1.19.m19.4.4.4.cmml" xref="S2.SS2.p1.19.m19.4.4.4"><times id="S2.SS2.p1.19.m19.4.4.4.1.cmml" xref="S2.SS2.p1.19.m19.4.4.4.1"></times><ci id="S2.SS2.p1.19.m19.4.4.4.2.cmml" xref="S2.SS2.p1.19.m19.4.4.4.2">ℒ</ci><ci id="S2.SS2.p1.19.m19.1.1.cmml" xref="S2.SS2.p1.19.m19.1.1">𝜃</ci></apply><apply id="S2.SS2.p1.19.m19.4.4.2.cmml" xref="S2.SS2.p1.19.m19.4.4.2"><times id="S2.SS2.p1.19.m19.4.4.2.3.cmml" xref="S2.SS2.p1.19.m19.4.4.2.3"></times><apply id="S2.SS2.p1.19.m19.4.4.2.4.cmml" xref="S2.SS2.p1.19.m19.4.4.2.4"><csymbol cd="ambiguous" id="S2.SS2.p1.19.m19.4.4.2.4.1.cmml" xref="S2.SS2.p1.19.m19.4.4.2.4">superscript</csymbol><ci id="S2.SS2.p1.19.m19.4.4.2.4.2.cmml" xref="S2.SS2.p1.19.m19.4.4.2.4.2">𝑁</ci><apply id="S2.SS2.p1.19.m19.4.4.2.4.3.cmml" xref="S2.SS2.p1.19.m19.4.4.2.4.3"><minus id="S2.SS2.p1.19.m19.4.4.2.4.3.1.cmml" xref="S2.S