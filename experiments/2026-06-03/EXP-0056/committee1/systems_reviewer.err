ligraphic_S start_POSTSUPERSCRIPT ( italic_k , italic_m ) end_POSTSUPERSCRIPT end_POSTSUBSCRIPT italic_X start_POSTSUBSCRIPT italic_i end_POSTSUBSCRIPT italic_Y start_POSTSUBSCRIPT italic_i end_POSTSUBSCRIPT</annotation></semantics></math>. By iteratively applying the updating formula (<a class="ltx_ref" href="#S3.Ex1" title="3.1.1 Linear system ‣ 3.1 Convergence analysis for linear regression model ‣ 3 Theoretical Results"><span class="ltx_text ltx_ref_tag">3.1.1</span></a>), we can further obtain that the updating formula between <math alttext="(k-1)" class="ltx_Math" display="inline" id="S3.SS1.SSS1.p1.7.m4.1"><semantics id="S3.SS1.SSS1.p1.7.m4.1a"><mrow id="S3.SS1.SSS1.p1.7.m4.1.1.1" xref="S3.SS1.SSS1.p1.7.m4.1.1.1.1.cmml"><mo id="S3.SS1.SSS1.p1.7.m4.1.1.1.2" stretchy="false" xref="S3.SS1.SSS1.p1.7.m4.1.1.1.1.cmml">(</mo><mrow id="S3.SS1.SSS1.p1.7.m4.1.1.1.1" xref="S3.SS1.SSS1.p1.7.m4.1.1.1.1.cmml"><mi id="S3.SS1.SSS1.p1.7.m4.1.1.1.1.2" xref="S3.SS1.SSS1.p1.7.m4.1.1.1.1.2.cmml">k</mi><mo id="S3.SS1.SSS1.p1.7.m4.1.1.1.1.1" xref="S3.SS1.SSS1.p1.7.m4.1.1.1.1.1.cmml">−</mo><mn id="S3.SS1.SSS1.p1.7.m4.1.1.1.1.3" xref="S3.SS1.SSS1.p1.7.m4.1.1.1.1.3.cmml">1</mn></mrow><mo id="S3.SS1.SSS1.p1.7.m4.1.1.1.3" stretchy="false" xref="S3.SS1.SSS1.p1.7.m4.1.1.1.1.cmml">)</mo></mrow><annotation-xml encoding="MathML-Content" id="S3.SS1.SSS1.p1.7.m4.1b"><apply id="S3.SS1.SSS1.p1.7.m4.1.1.1.1.cmml" xref="S3.SS1.SSS1.p1.7.m4.1.1.1"><minus id="S3.SS1.SSS1.p1.7.m4.1.1.1.1.1.cmml" xref="S3.SS1.SSS1.p1.7.m4.1.1.1.1.1"></minus><ci id="S3.SS1.SSS1.p1.7.m4.1.1.1.1.2.cmml" xref="S3.SS1.SSS1.p1.7.m4.1.1.1.1.2">𝑘</ci><cn id="S3.SS1.SSS1.p1.7.m4.1.1.1.1.3.cmml" type="integer" xref="S3.SS1.SSS1.p1.7.m4.1.1.1.1.3">1</cn></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS1.SSS1.p1.7.m4.1c">(k-1)</annotation><annotation encoding="application/x-llamapun" id="S3.SS1.SSS1.p1.7.m4.1d">( italic_k - 1 )</annotation></semantics></math>-th and <math alttext="k" class="ltx_Math" display="inline" id="S3.SS1.SSS1.p1.8.m5.1"><semantics id="S3.SS1.SSS1.p1.8.m5.1a"><mi id="S3.SS1.SSS1.p1.8.m5.1.1" xref="S3.SS1.SSS1.p1.8.m5.1.1.cmml">k</mi><annotation-xml encoding="MathML-Content" id="S3.SS1.SSS1.p1.8.m5.1b"><ci id="S3.SS1.SSS1.p1.8.m5.1.1.cmml" xref="S3.SS1.SSS1.p1.8.m5.1.1">𝑘</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.SS1.SSS1.p1.8.m5.1c">k</annotation><annotation encoding="application/x-llamapun" id="S3.SS1.SSS1.p1.8.m5.1d">italic_k</annotation></semantics></math>-th buffers:</p>
