4.m6.1.1.2.1.cmml" xref="S3.SS1.SSS1.p1.14.m6.1.1.2">subscript</csymbol><ci id="S3.SS1.SSS1.p1.14.m6.1.1.2.2.cmml" xref="S3.SS1.SSS1.p1.14.m6.1.1.2.2">𝐼</ci><ci id="S3.SS1.SSS1.p1.14.m6.1.1.2.3.cmml" xref="S3.SS1.SSS1.p1.14.m6.1.1.2.3">𝑝</ci></apply><apply id="S3.SS1.SSS1.p1.14.m6.1.1.3.cmml" xref="S3.SS1.SSS1.p1.14.m6.1.1.3"><csymbol cd="ambiguous" id="S3.SS1.SSS1.p1.14.m6.1.1.3.1.cmml" xref="S3.SS1.SSS1.p1.14.m6.1.1.3">superscript</csymbol><ci id="S3.SS1.SSS1.p1.14.m6.1.1.3.2.cmml" xref="S3.SS1.SSS1.p1.14.m6.1.1.3.2">ℝ</ci><apply id="S3.SS1.SSS1.p1.14.m6.1.1.3.3.cmml" xref="S3.SS1.SSS1.p1.14.m6.1.1.3.3"><times id="S3.SS1.SSS1.p1.14.m6.1.1.3.3.1.cmml" xref="S3.SS1.SSS1.p1.14.m6.1.1.3.3.1"></times><ci id="S3.SS1.SSS1.p1.14.m6.1.1.3.3.2.cmml" xref="S3.SS1.SSS1.p1.14.m6.1.1.3.3.2">𝑝</ci><ci id="S3.SS1.SSS1.p1.14.m6.1.1.3.3.3.cmml" xref="S3.SS1.SSS1.p1.14.m6.1.1.3.3.3">𝑝</ci></apply></apply></apply></annotation-xml><annotation encoding="application/x-tex" id="S3.SS1.SSS1.p1.14.m6.1c">I_{p}\in\mathbb{R}^{p\times p}</annotation><annotation encoding="application/x-llamapun" id="S3.SS1.SSS1.p1.14.m6.1d">italic_I start_POSTSUBSCRIPT italic_p end_POSTSUBSCRIPT ∈ blackboard_R start_POSTSUPERSCRIPT italic_p × italic_p end_POSTSUPERSCRIPT</annotation></semantics></math> is an identity matrix. Next, to analyze the stable solution in an iteration, we stack the estimators from all the <math alttext="K" class="ltx_Math" display="inline" id="S3.SS1.SSS1.p1.15.m7.1"><semantics id="S3.SS1.SSS1.p1.15.m7.1a"><mi id="S3.SS1.SSS1.p1.15.m7.1.1" xref="S3.SS1.SSS1.p1.15.m7.1.1.cmml">K</mi><annotation-xml encoding="MathML-Content" id="S3.SS1.SSS1.p1.15.m7.1b"><ci id="S3.SS1.SSS1.p1.15.m7.1.1.cmml" xref="S3.SS1.SSS1.p1.15.m7.1.1">𝐾</ci></annotation-xml><annotation encoding="application/x-tex" id="S3.SS1.SSS1.p1.15.m7.1c">K</annotation><annotation encoding="application/x-llamapun" id="S3.SS1.SSS1.p1.15.m7.1d">italic_K</annotation></semantics></math> buffers together and obtain the estimator for the BMGD algorithm in vector form. Specifically, we let <math alttext="\widehat{\theta}_{r}^{*}=(\widehat{\theta}^{(T,M)\top}_{r,1},\widehat{\theta}^%
