  {system: "SGLang RadixAttention / scheduler LPM", url: "https://github.com/sgl-project/sglang/blob/main/python/sglang/srt/managers/schedule_policy.py", overlap: "Implements cache-aware longest-prefix-match scheduling over the waiting queue; overlaps the greedy/cache-aware baseline, not an explicit p99/skip-budget fairness cap."},
  {system: "vLLM Automatic Prefix Caching", url: "https://docs.vllm.ai/en/latest/design/prefix_caching/", overlap: "Ships prefix KV block reuse via get_computed_blocks()/allocate_slots(); vLLM request queues are FCFS/priority, not the claimed bounded-W cache-aware admission."},
  {system: "VTC / Virtual Token Counter", url: "https://www.usenix.org/conference/osdi24/presentation/sheng", overlap: "Implements the fair-scheduling baseline; ignores prefix reuse in the packet's framing."},
  {system: "Preble", url: "https://arxiv.org/abs/2407.00023", overlap: "Distributed prompt scheduling co-optimizing KV reuse and load balancing; close prior work for prefix-aware scheduling, but not the same explicit p99 wait budget."},
  {system: "TensorRT-LLM KV cache reuse", url: "https://nvidia.github.io/TensorRT-LLM/advanced/kv-cache-reuse.html", overlap: "Ships KV cache reuse enabled by default in KVCacheManager; docs state launching new requests takes priority over possible reuse, not bounded fairness/cache admission."},
