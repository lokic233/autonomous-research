ROLE: systems_reviewer  VOTE: yellow
EXISTING_IMPLEMENTATIONS: [
  {system: "ACON", url: "https://github.com/microsoft/acon / https://arxiv.org/abs/2510.00615", overlap: "High: long-horizon LLM agent context compression of observations/history, evaluated on AppWorld/OfficeBench/Multi-objective QA; reports 26-54% peak-token reduction and task-success gains. Does not appear to use this packet's exact extractive future-reference predictor/oracle-gap framing."},
  {system: "LLMLingua / LongLLMLingua", url: "https://github.com/microsoft/LLMLingua", overlap: "Medium: prompt/context compression with token removal and long-context/RAG use cases; not tool-result-specific and not causal future-reference retention."},
  {system: "H2O", url: "https://github.com/FMInference/H2O", overlap: "Medium: attention-heavy-hitter KV eviction retaining recent + high-attention tokens; overlaps with attention-based retention, not agent transcript/tool-result extraction."},
  {system: "SnapKV", url: "https://arxiv.org/abs/2404.14469", overlap: "Medium: KV compression by selecting important positions from attention features; reports 3.6x generation speed and 8.2x memory efficiency at 16K tokens; not committed tool-result compression."},
  {system: "StreamingLLM", url: "https://github.com/mit-han-lab/streaming-llm", overlap: "Low/medium: production-integrated recency + attention-sink retention for streaming dialogue; closest to the RT-style baseline, not semantic reference prediction."},
  {system: "vLLM Automatic Prefix Caching", url: "https://docs.vllm.ai/en/latest/design/prefix_caching/", overlap: "Low: shipping KV prefix reuse with LRU block eviction; reduces recompute, does not compress transcript by future utility."},
  {system: "LMCache", url: "https://github.com/LMCache/LMCache", overlap: "Low: shipping KV reuse/offload for reused text across GPU/CPU/disk/S3 and vLLM/SGLang integrations; cache reuse, not extractive content selection."},
  {system: "TensorRT-LLM KV cache reuse", url: "https://nvidia.github.io/TensorRT-LLM/advanced/kv-cache-reuse.html", overlap: "Low: serving-system KV reuse; not tool-output semantic compression."}
