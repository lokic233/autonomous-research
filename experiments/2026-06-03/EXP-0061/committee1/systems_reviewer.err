  <meta name="description" content="Abstract page for arXiv paper 2107.06499: Deduplicating Training Data Makes Language Models Better"><meta property="og:type" content="website" />
<meta property="og:site_name" content="arXiv.org" />
<meta property="og:title" content="Deduplicating Training Data Makes Language Models Better" />
<meta property="og:url" content="https://arxiv.org/abs/2107.06499v2" />
<meta property="og:image" content="/static/browse/0.3.4/images/arxiv-logo-fb.png" />
