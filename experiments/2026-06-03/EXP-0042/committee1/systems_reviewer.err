              var ctaBtn = document.createElement('a');
              ctaBtn.style.cssText = 'display:inline-flex;align-items:center;padding:0.375rem 0.75rem;font-size:0.8125rem;font-weight:600;color:#fff;background:var(--ll-vibrant-purple,#3E18F9);border:1px solid var(--ll-vibrant-purple,#3E18F9);border-radius:0.375rem;cursor:pointer;transition:all 0.15s;margin-left:0.25rem;white-space:nowrap;text-decoration:none;';

              function updateCta() {
                var path = window.location.pathname;
                if (path.startsWith('/python/framework')) {
                  ctaBtn.textContent = 'GitHub';
                  ctaBtn.href = 'https://github.com/run-llama/llama_index';
                  ctaBtn.target = '_blank';
                } else {
                  ctaBtn.textContent = 'API Dashboard';
                  ctaBtn.href = 'https://cloud.llamaindex.ai';
                  ctaBtn.target = '';
                }
              }
              updateCta();
              document.addEventListener('astro:page-load', updateCta);

              rightGroup.appendChild(ctaBtn);
            });
            
