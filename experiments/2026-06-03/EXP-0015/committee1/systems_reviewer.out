EXISTING_IMPLEMENTATIONS: [
  {system: "vLLM", url: "https://github.com/vllm-project/vllm/blob/main/docs/configuration/optimization.md#preemption", overlap: "Shipping KV-cache preemption/recompute plus priority scheduling/abort APIs; overlaps with the proposed reclaim path once abandonment-risk becomes preempt/kill."},
  {system: "SGLang", url: "https://github.com/sgl-project/sglang", overlap: "Shipping scheduler has request abort, priority scheduling, priority preemption flags, queue rejection/eviction; overlaps with deprioritize/kill integration."},
  {system: "TensorRT-LLM", url: "https://nvidia.github.io/TensorRT-LLM/torch/scheduler.html", overlap: "Scheduler is explicitly customizable via CapacityScheduler/MicroBatchScheduler; supports active/paused request selection. This makes the proposed policy mostly scheduler glue."},
  {system: "Llumnix", url: "https://arxiv.org/abs/2406.03243", overlap: "Dynamic runtime rescheduling/live migration across model instances, priority/SLO differentiation, cost savings; covers the generic systems mechanism claimed here."},
  {system: "FastServe", url: "https://www.usenix.org/conference/nsdi26/presentation/wu-bingyang", overlap: "Iteration-level preemptive scheduling for LLM inference; directly overlaps with token-granularity preemption/deprioritization."}
